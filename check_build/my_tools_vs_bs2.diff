+class PolicyProbeCallback:                              # a stand-in with the real class's name and bank shape
+    def __init__(self, bank):
+        self.bank = bank
+        self.seen = []
+
+    def _row(self):
+        self.seen.append(np.array(self.bank.raw_obs, copy=True))
+        return {"row": len(self.seen)}

+        steps: np.ndarray
+        raw_obs: np.ndarray
+
+    return Bank(labels=("statue_settled", "statue", "ankle_minus_0.05_at400"), steps=np.array([199, 599, 400]),
+                raw_obs=np.zeros((3, OBS)))

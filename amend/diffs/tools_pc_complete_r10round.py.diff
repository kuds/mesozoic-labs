+def c8_holds(rec: dict, run_id) -> bool:
+    """PC AMENDMENT: whether a manipulation-check record (bound to the label's pair) meets C8 for the run's arm: a
+    phase run's reads "IN FORCE"; a switch-off run's is the stock-critic record (its critic reads no phase)."""

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.so

# Virtual environments
venv/
.venv/
env/

# uv writes this whenever anything resolves dependencies (`uv run`, `uv sync`),
# so it reappears on any machine that runs the test suite. The repository has
# never tracked it and pins reproducibility elsewhere -- `provenance.json`
# records the repository commit, config hash and backend version for every run
# -- so it is ignored rather than committed. Delete this line if the project
# later wants the resolved dependency set under version control.
uv.lock

# IDE
.vscode/
.idea/
*.swp
*.swo

# Training artifacts
logs/
models/
# "models/" is unanchored, so it matches a directory of that name at ANY depth
# — including the documentation tree, where it silently swallowed newly added
# model pages. The existing pages there were unaffected because git never
# ignores already-tracked files, so this only ever bit new files and did so
# without any warning from `git add -A`.
!website/docs/models/
*.zip
*.pkl
*.npz
tensorboard/

# Jupyter
.ipynb_checkpoints/

# Node / Docusaurus
node_modules/
website/build/
website/.docusaurus/
website/.cache-loader/

# Environment
.env
.env.local

# Coverage
.coverage
htmlcov/

# MuJoCo
*.mjb
MUJOCO_LOG.TXT

+def _stem(name: str) -> str:
+    return name[: -len("_act")] if name.endswith("_act") else name
+
+
+def _smooth(values: np.ndarray, window: int) -> np.ndarray:
+    """A centred rolling mean over *window* evaluations of the finite values, the window cut at the ends.
+
+    NaN where the window holds no finite value; the output is as long as the input.
+    """
+    values = np.asarray(values, dtype=float)
+    if window <= 1 or values.size == 0:
+        return values
+    finite = np.isfinite(values)
+    total = np.concatenate(([0.0], np.cumsum(np.where(finite, values, 0.0))))
+    count = np.concatenate(([0.0], np.cumsum(finite.astype(float))))
+    index = np.arange(values.size)
+    low = np.clip(index - (window - 1) // 2, 0, values.size)
+    high = np.clip(index + window // 2 + 1, 0, values.size)
+    sums, counts = total[high] - total[low], count[high] - count[low]
+    with np.errstate(invalid="ignore", divide="ignore"):
+        return np.where(counts > 0, sums / np.where(counts > 0, counts, 1.0), np.nan)
+
+
+def _values(
+    run: RunHistory, quantity: Quantity, foot: str | None, stat: str = "mean"
+) -> tuple[np.ndarray, np.ndarray] | None:
+    """``(x in millions of steps, y)`` of one quantity for one run, or ``None`` when absent."""
+    if quantity.kind == "training":
+        if run.training is None:
+            return None
+        return run.training["window_end"] / 1e6, np.asarray(run.training[quantity.key], dtype=float)
+    if quantity.kind == "count":
+        series = run.series(quantity.key)
+        return None if series is None else (run.steps / 1e6, series)
+    key = quantity.key
+    if key.startswith("lr:"):
+        column = run.lr.get(key[3:])
+        if column is None:
+            return None
+        key = column
+    elif foot is not None:
+        key = key.format(foot=foot)
+    values = run.column(key, stat)
+    return None if values is None else (run.steps / 1e6, values * quantity.scale)
+
+
+def _reference_lines(runs: Sequence[RunHistory], quantity: Quantity) -> list[tuple[float, str, str]]:
+    """``(y, label, linestyle)`` of the bars, band edges and zero lines a panel draws."""
+
+    def common(values: Iterable[float | None]) -> list[float]:
+        return sorted({float(v) for v in values if v is not None and math.isfinite(v)})
+
+    lines: list[tuple[float, str, str]] = []
+    key = quantity.key
+    banded = [run for run in runs if run.band_active]
+    if key == "{foot}_foot_cop_fore_aft":
+        for name in ("lower", "upper"):
+            for value in common((run.band or {}).get(f"{BAND_PREFIX}{name}") for run in banded):
+                lines.append((value, f"band {name} edge {value:+g} (reward)", ":"))
+        for value in common(run.bars.get("max_foot_cop_fore_aft") for run in runs):
+            lines += [(value, f"max_foot_cop_fore_aft bar +/-{value:g}", "--"), (-value, "", "--")]
+    elif key == "{foot}_sole_cop_fore_aft":
+        for value in common(run.bars.get("max_sole_cop_fore_aft") for run in runs):
+            lines += [(value, f"max_sole_cop_fore_aft bar +/-{value:g}", "--"), (-value, "", "--")]
+        for name in ("lower", "upper"):
+            for value in common((run.band or {}).get(f"{BAND_PREFIX}pad_{name}") for run in banded):
+                lines.append((value, f"pad band {name} edge {value:+g} (reward)", ":"))
+    elif key in ("max_sole_tilt_deg", "max_sole_corner_lift_m"):
+        for value in common(run.bars.get(key) for run in runs):
+            lines.append((value * quantity.scale, f"{key} bar {value:g}", "--"))
+    elif key == "saturated":
+        lines.append((float(SATURATION_FLAG_EPISODES), f"flag: >= {SATURATION_FLAG_EPISODES} episodes", "--"))
+    if key.endswith(("cop_fore_aft", "margin_min_m", "com_fore_aft_mean_m", "shear_over_normal")) or key.startswith(
+        "lr:"
+    ):
+        lines.append((0.0, "", "-"))
+    return lines
+
+
+def _new_figure(panels: int, *, width: float, panel_height: float, dpi: int, columns: int = 1) -> tuple[Any, Any]:
+    from matplotlib.backends.backend_agg import FigureCanvasAgg
+    from matplotlib.figure import Figure
+
+    rows = int(math.ceil(panels / columns))
+    figure = Figure(figsize=(width, 1.3 + panel_height * rows), dpi=dpi, layout="constrained")
+    FigureCanvasAgg(figure)
+    axes = figure.subplots(rows, columns, sharex=True, squeeze=False)
+    return figure, axes
+
+
+def _style_axis(axis: Any, title: str, unit: str, *, width: float) -> None:
+    axis.set_title(textwrap.fill(title, width=int(width * 11)), loc="left", fontsize=10, color=_INK)
+    axis.set_ylabel(unit, fontsize=9.5, color=_INK_2)
+    axis.grid(True, color=_GRID, linewidth=0.7)
+    axis.set_facecolor(_SURFACE)
+    for side in ("top", "right"):
+        axis.spines[side].set_visible(False)
+    for side in ("left", "bottom"):
+        axis.spines[side].set_color("#c3c2b7")
+    axis.tick_params(colors=_INK_2, labelsize=9)
+
+
+def _absent(axis: Any, text: str) -> None:
+    axis.text(0.5, 0.5, text, transform=axis.transAxes, ha="center", va="center", fontsize=9.5, color=_MUTED, wrap=True)
+
+
+@dataclass
+class _Context:
+    runs: Sequence[RunHistory]
+    marks: Sequence[int]
+    comparison: bool
+    smooth: int
+    xmax: float
+    colours: dict[str, str]
+    styles: dict[str, Any]
+
+
+def _draw_marks(axis: Any, context: _Context, *, top: bool) -> None:
+    """The J checkpoints (grey), the handoff and best checkpoints (one run, green) and the saturation alarms.
+
+    One run's pages mark every alarm (each run of flagged evaluations); a comparison marks each run's first.
+    """
+    from matplotlib.transforms import blended_transform_factory
+
+    transform = blended_transform_factory(axis.transData, axis.transAxes)
+    for step in context.marks:
+        x = step / 1e6
+        if x <= context.xmax:
+            axis.axvline(x, color=_MUTED, linewidth=0.9, alpha=0.6, zorder=0)
+            if top:
+                axis.text(x, 1.0, "J", transform=transform, ha="center", va="bottom", fontsize=8, color=_INK_2)
+    if not context.comparison:
+        run = context.runs[0]
+        for kind, style in (("robust_best", "--"), ("best", ":")):
+            saved = run.checkpoint_steps.get(kind)
+            if isinstance(saved, int) and (kind == "robust_best" or saved != run.checkpoint_steps.get("robust_best")):
+                axis.axvline(saved / 1e6, color=_HANDOFF, linestyle=style, linewidth=1.2, zorder=1)
+    for run in context.runs:
+        alarms = run.saturation.get("runs", []) if run.saturation.get("alarm") else []
+        for entry in alarms[:1] if context.comparison else alarms:
+            colour = _CRITICAL if not context.comparison else context.colours[run.label]
+            axis.axvline(entry["alarm_at"] / 1e6, color=colour, linestyle=(0, (1.5, 1.5)), linewidth=1.8, zorder=3)
+
+
+def _draw_quantity(axis: Any, context: _Context, quantity: Quantity, foot: str | None) -> bool:
+    """Draw one panel; ``False`` when no run has the quantity."""
+    drawn = False
+    for index, run in enumerate(context.runs):
+        feet = [foot] if foot is not None else (run.feet if quantity.per_foot else [None])
+        for foot_index, which in enumerate(feet):
+            values = _values(run, quantity, which)
+            if values is None:
+                continue
+            x, y = values
+            drawn = True
+            if context.comparison:
+                y = _smooth(y, context.smooth) if quantity.smooth else y
+                axis.plot(
+                    x,
+                    y,
+                    color=context.colours[run.label],
+                    linestyle=context.styles[run.label],
+                    linewidth=1.6,
+                    label="_nolegend_",
+                )
+                continue
+            colour = _SERIES[foot_index % len(_SERIES)] if quantity.per_foot else _SERIES[0]
+            label = f"foot {which}" if which is not None else None
+            axis.plot(x, y, color=colour, linewidth=1.6, label=label, marker="o" if x.size < 40 else None, markersize=3)
+            if quantity.spread == "std":
+                spread = _values(run, quantity, which, "std")
+                if spread is not None:
+                    axis.fill_between(x, y - spread[1], y + spread[1], color=colour, alpha=0.15, linewidth=0)
+            elif quantity.spread in ("max", "min"):
+                worst = _values(run, quantity, which, quantity.spread)
+                if worst is not None:
+                    axis.plot(
+                        x,
+                        worst[1],
+                        color=colour,
+                        linewidth=1.0,
+                        linestyle="--",
+                        alpha=0.8,
+                        label=f"worst episode{f' ({which})' if which else ''}",
+                    )
+            if quantity.key == "saturated":
+                hits = [i for step in run.saturation.get("flagged", []) if (i := _at(run, step)) is not None]
+                axis.plot(
+                    x[hits],
+                    y[hits],
+                    linestyle="none",
+                    marker="o",
+                    markersize=4.5,
+                    color=_CRITICAL,
+                    label="flagged evaluation",
+                )
+    if not drawn:
+        return False
+    for level, label, style in _reference_lines(context.runs, quantity):
+        colour = "#c3c2b7" if style == "-" else _INK_2
+        axis.axhline(
+            level, color=colour, linestyle=style, linewidth=1.1 if style != "-" else 0.9, label=label or None, zorder=1
+        )
+    if quantity.kind == "count" and quantity.key in ("clean", "falls", "saturated"):
+        episodes = [run.series("episodes") for run in context.runs]
+        top = max((float(np.nanmax(e)) for e in episodes if e is not None and e.size), default=1.0)
+        axis.set_ylim(-0.3, top + 0.3)
+    if quantity.key == "fall_fraction":
+        axis.set_ylim(bottom=0.0)
+    return True
+
+
+def _legend(axis: Any) -> None:
+    """The panel's own legend, outside its right edge so that it hides no data."""
+    handles, labels = axis.get_legend_handles_labels()
+    if labels:
+        axis.legend(fontsize=8.5, loc="upper left", bbox_to_anchor=(1.005, 1.0), frameon=False, borderaxespad=0.0)
+
+
+def _run_handles(context: _Context) -> tuple[list[Any], list[str]]:
+    from matplotlib.lines import Line2D
+
+    handles: list[Any] = []
+    labels: list[str] = []
+    for run in context.runs:
+        handles.append(
+            Line2D([], [], color=context.colours[run.label], linestyle=context.styles[run.label], linewidth=2)
+        )
+        labels.append(f"{run.label}" + (f" ({run.group})" if run.group else ""))
+    handles.append(Line2D([], [], color=_MUTED, linewidth=1.0))
+    labels.append("J checkpoint")
+    if any(run.saturation.get("alarm") for run in context.runs):
+        handles.append(Line2D([], [], color=_INK_2, linestyle=(0, (1.5, 1.5)), linewidth=1.8))
+        labels.append("first saturation alarm (run colour)")
+    return handles, labels
+
+
+def _single_handles(context: _Context) -> tuple[list[Any], list[str]]:
+    from matplotlib.lines import Line2D
+
+    run = context.runs[0]
+    handles: list[Any] = [Line2D([], [], color=_MUTED, linewidth=1.0)]
+    labels = ["J checkpoint"]
+    if isinstance(run.checkpoint_steps.get("robust_best"), int):
+        handles.append(Line2D([], [], color=_HANDOFF, linestyle="--", linewidth=1.2))
+        labels.append(f"robust_best (handoff) {run.checkpoint_steps['robust_best']:,}")
+    best = run.checkpoint_steps.get("best")
+    if isinstance(best, int) and best != run.checkpoint_steps.get("robust_best"):
+        handles.append(Line2D([], [], color=_HANDOFF, linestyle=":", linewidth=1.2))
+        labels.append(f"best {best:,}")
+    if run.saturation.get("alarm"):
+        handles.append(Line2D([], [], color=_CRITICAL, linestyle=(0, (1.5, 1.5)), linewidth=1.8))
+        count = len(run.saturation["runs"])
+        labels.append(
+            f"saturation alarm (first {run.saturation['first_alarm_at']:,}"
+            + (f"; {count} runs of flagged evaluations)" if count > 1 else ")")
+        )
+    return handles, labels
+
+
+def _png(figure: Any, dpi: int) -> bytes:
+    """The figure as PNG bytes, quantised to a 256-colour palette when Pillow is importable (line art keeps)."""
+    buffer = io.BytesIO()
+    figure.savefig(buffer, format="png", dpi=dpi, facecolor="white")
+    data = buffer.getvalue()
+    try:
+        from PIL import Image
+    except ImportError:
+        return data
+    image = Image.open(io.BytesIO(data)).convert("RGB")
+    quantised = image.quantize(colors=256, method=Image.Quantize.MEDIANCUT, dither=Image.Dither.NONE)
+    out = io.BytesIO()
+    quantised.save(out, format="PNG", optimize=True)
+    return out.getvalue() if len(out.getvalue()) < len(data) else data
+
+
+@dataclass
+class Page:
+    """One rendered page."""
+
+    name: str
+    title: str
+    caption: str
+    png: bytes
+
+
+def _page_figure(spec: PageSpec, context: _Context, *, title: str, dpi: int, width: float) -> Any:
+    panels: list[tuple[Quantity, str | None]] = []
+    for quantity in spec.quantities:
+        if quantity.per_foot and context.comparison:
+            feet: list[str] = []
+            for run in context.runs:
+                feet += [foot for foot in run.feet if foot not in feet]
+            panels += [(quantity, foot) for foot in (feet or ["r", "l"])]
+        else:
+            panels.append((quantity, None))
+    figure, axes = _new_figure(len(panels), width=width, panel_height=2.55 if len(panels) > 1 else 3.4, dpi=dpi)
+    figure.patch.set_facecolor("white")
+    figure.suptitle(f"{title}\n{spec.title}", fontsize=12, color=_INK, x=0.01, ha="left")
+    for index, (axis, (quantity, foot)) in enumerate(zip(axes[:, 0], panels)):
+        heading = quantity.title if foot is None else f"Foot {foot}: {quantity.title}"
+        if context.comparison and quantity.smooth and context.smooth > 1:
+            heading += f" [rolling mean over {context.smooth} evaluations]"
+        elif not context.comparison and quantity.spread in _SPREAD_NOTES:
+            heading += _SPREAD_NOTES[quantity.spread]
+        _style_axis(axis, heading, quantity.unit, width=width)
+        if not _draw_quantity(axis, context, quantity, foot):
+            column = quantity.key.replace("{foot}", foot or "<foot>")
+            _absent(axis, f"not recorded in these files ({column})")
+        _draw_marks(axis, context, top=index == 0)
+        _legend(axis)
+        axis.set_xlim(0.0, context.xmax * 1.01 if context.xmax > 0 else 1.0)
+    axes[-1, 0].set_xlabel("training steps (millions)", fontsize=9.5, color=_INK_2)
+    handles, labels = _run_handles(context) if context.comparison else _single_handles(context)
+    figure.legend(handles, labels, loc="outside lower center", ncol=min(5, len(labels)), fontsize=9, frameon=False)
+    return figure
+
+
+def _std_figure(context: _Context, *, title: str, dpi: int, width: float) -> Any:
+    """Per-actuator std at the checkpoints: one run's actuators, or one panel per key actuator across runs."""
+    names = next((run.actuators for run in context.runs if run.actuators), None)
+    markers = {"periodic": "o", "robust_best": "D", "best": "^", "final": "s"}
+    if not context.comparison or names is None:
+        run = context.runs[0]
+        points = run.policy_std.get("checkpoints", [])
+        figure, axes = _new_figure(2, width=width, panel_height=3.2, dpi=dpi)
+        figure.patch.set_facecolor("white")
+        figure.suptitle(
+            f"{title}\nPer-actuator policy std, exp(log_std), at the checkpoints",
+            fontsize=12,
+            color=_INK,
+            x=0.01,
+            ha="left",
+        )
+        steps = np.asarray([p["timesteps"] if p["timesteps"] is not None else np.nan for p in points], dtype=float)
+        stds = np.asarray([p["std"] for p in points], dtype=float) if points else np.zeros((0, 0))
+        labels = (
+            [_stem(n) for n in run.actuators]
+            if run.actuators
+            else [f"actuator {i}" for i in range(stds.shape[1] if stds.size else 0)]
+        )
+        key = [i for i, n in enumerate(labels) if any(k in n for k in KEY_ACTUATORS)] if run.actuators else []
+        rest = [i for i in range(len(labels)) if i not in key]
+        groups = ((key, "Legs and tail_3 (right solid, left dashed; colour per joint)"), (rest, "The other actuators"))
+        for axis, (indices, heading) in zip(axes[:, 0], groups):
+            _style_axis(axis, f"{heading}; {run.label}", "std (action units, log)", width=width)
+            if not points or not indices:
+                _absent(axis, "no per-actuator std: " + (run.policy_std.get("skipped") or "no actuator names"))
+                continue
+            joints: list[str] = []
+            for i in indices:
+                stem = labels[i]
+                joint = re.sub(r"^(r|l|right|left)_", "", stem)
+                if joint not in joints:
+                    joints.append(joint)
+                fixed = next((k for k in KEY_ACTUATORS if k in joint), None) if axis is axes[0, 0] else None
+                colour = _KEY_COLOURS[fixed] if fixed else _SERIES[joints.index(joint) % len(_SERIES)]
+                style = "--" if re.match(r"^(l|left)_", stem) else "-"
+                axis.plot(steps / 1e6, stds[:, i], color=colour, linestyle=style, linewidth=1.4, label=stem)
+                for kind, marker in markers.items():
+                    picks = [j for j, p in enumerate(points) if p["kind"] == kind]
+                    axis.plot(
+                        steps[picks] / 1e6, stds[picks, i], linestyle="none", marker=marker, markersize=5, color=colour
+                    )
+            axis.set_yscale("log")
+            _draw_marks(axis, context, top=axis is axes[0, 0])
+            _legend(axis)
+            axis.set_xlim(0.0, context.xmax * 1.01 if context.xmax > 0 else 1.0)
+        axes[-1, 0].set_xlabel("training steps (millions)", fontsize=9.5, color=_INK_2)
+        handles, legend_labels = _single_handles(context)
+        from matplotlib.lines import Line2D
+
+        for kind, marker in markers.items():
+            handles.append(Line2D([], [], linestyle="none", marker=marker, color=_INK_2))
+            legend_labels.append(f"{kind} checkpoint" if kind != "periodic" else "periodic checkpoint")
+        figure.legend(handles, legend_labels, loc="outside lower center", ncol=4, fontsize=9, frameon=False)
+        return figure
+
+    def order(index: int) -> tuple[int, int, int]:
+        stem = _stem(names[index])
+        joint = next(i for i, k in enumerate(KEY_ACTUATORS) if k in stem)
+        return joint, 1 if re.match(r"^(l|left)_", stem) else 0, index
+
+    # Right beside left, one joint per row, in KEY_ACTUATORS' order.
+    chosen = sorted((i for i, n in enumerate(names) if any(k in n for k in KEY_ACTUATORS)), key=order)
+    figure, axes = _new_figure(len(chosen), width=width, panel_height=2.3, dpi=dpi, columns=2)
+    figure.patch.set_facecolor("white")
+    figure.suptitle(
+        f"{title}\nPer-actuator policy std, exp(log_std), at each run's checkpoints",
+        fontsize=12,
+        color=_INK,
+        x=0.01,
+        ha="left",
+    )
+    flat = axes.reshape(-1)
+    for axis, index in zip(flat, chosen):
+        _style_axis(axis, _stem(names[index]), "std (log)", width=width / 2)
+        for run in context.runs:
+            points = [p for p in run.policy_std.get("checkpoints", []) if p["timesteps"] is not None]
+            if not points or run.actuators != names:
+                continue
+            x = np.asarray([p["timesteps"] for p in points], dtype=float) / 1e6
+            y = np.asarray([p["std"][index] for p in points], dtype=float)
+            axis.plot(x, y, color=context.colours[run.label], linestyle=context.styles[run.label], linewidth=1.4)
+            for kind, marker in markers.items():
+                picks = [j for j, p in enumerate(points) if p["kind"] == kind]
+                axis.plot(
+                    x[picks],
+                    y[picks],
+                    linestyle="none",
+                    marker=marker,
+                    markersize=4.5,
+                    color=context.colours[run.label],
+                )
+        axis.set_yscale("log")
+        _draw_marks(axis, context, top=False)
+        axis.set_xlim(0.0, context.xmax * 1.01)
+    for axis in flat[len(chosen) :]:
+        axis.set_visible(False)
+    if len(chosen) % 2 and axes.shape[0] > 1:
+        axes[-2, 1].xaxis.set_tick_params(labelbottom=True)
+        axes[-2, 1].set_xlabel("training steps (millions)", fontsize=9.5, color=_INK_2)
+    axes[-1, 0].set_xlabel("training steps (millions)", fontsize=9.5, color=_INK_2)
+    from matplotlib.lines import Line2D
+
+    handles, labels = _run_handles(context)
+    for kind, marker in markers.items():
+        handles.append(Line2D([], [], linestyle="none", marker=marker, color=_INK_2))
+        labels.append(f"{kind} checkpoint")
+    figure.legend(handles, labels, loc="outside lower center", ncol=4, fontsize=9, frameon=False)
+    return figure
+
+
+def render_pages(
+    runs: Sequence[RunHistory],
+    *,
+    title: str,
+    marks: Sequence[int],
+    smooth: int = 5,
+    dpi: int = 80,
+    width: float = 12.0,
+) -> tuple[list[Page], list[str]]:
+    """Every page of *runs*: one run's page set, or the comparison set when there are several.
+
+    Returns the pages and the errors (one per page that failed; a failure costs that page only).
+    """
+    import matplotlib
+
+    if len(runs) > MAX_RUNS:
+        raise ValueError(f"at most {MAX_RUNS} runs per comparison (one categorical colour each), not {len(runs)}")
+    comparison = len(runs) > 1
+    groups: list[str] = []
+    for run in runs:
+        if run.group not in groups:
+            groups.append(run.group or "")
+    context = _Context(
+        runs=runs,
+        marks=marks,
+        comparison=comparison,
+        smooth=max(1, int(smooth)) if comparison else 1,
+        xmax=max((run.last_step for run in runs), default=0) / 1e6,
+        colours={run.label: _SERIES[i] for i, run in enumerate(runs)},
+        styles={run.label: _GROUP_STYLES[groups.index(run.group or "") % len(_GROUP_STYLES)] for run in runs},
+    )
+    pages: list[Page] = []
+    errors: list[str] = []
+    with matplotlib.rc_context({"font.family": "DejaVu Sans", "axes.titlepad": 10, "figure.facecolor": "white"}):
+        for spec in PAGES:
+            try:
+                figure = _page_figure(spec, context, title=title, dpi=dpi, width=width)
+                pages.append(Page(spec.name, spec.title, spec.caption, _png(figure, dpi)))
+            except Exception as exc:  # noqa: BLE001 - a failure costs this page only
+                logger.warning("training history page %s failed: %s", spec.name, exc)
+                errors.append(f"{spec.name}: {type(exc).__name__}: {exc}")
+        try:
+            figure = _std_figure(context, title=title, dpi=dpi, width=width)
+            caption = (
+                "exp(log_std) of each checkpoint's policy.pth (robust_best, best, final and up to "
+                f"{POLICY_STD_MAX_PERIODIC} periodic checkpoints kept in models/), in action units, log scale. "
+                "Actuator names come from the checkout's MJCF in actuator (action) order."
+            )
+            pages.append(Page("10_policy_std", "Per-actuator policy std", caption, _png(figure, dpi)))
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("training history page 10_policy_std failed: %s", exc)
+            errors.append(f"10_policy_std: {type(exc).__name__}: {exc}")
+    return pages, errors
+

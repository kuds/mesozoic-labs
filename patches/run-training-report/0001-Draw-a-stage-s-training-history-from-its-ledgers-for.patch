+nav a { color:var(--accent); margin-right:12px; font-size:13.5px; }
+"""
+
+
+def _std_order(key: str) -> tuple[int, int, str]:
+    """A std column's place: by joint in :data:`KEY_ACTUATORS`' order, right before left."""
+    stem = key[len("std_") :]
+    joint = next((i for i, k in enumerate(KEY_ACTUATORS) if k in stem), len(KEY_ACTUATORS))
+    return joint, 1 if re.match(r"^(l|left)_", stem) else 0, stem
+
+
+def _fmt(value: Any, digits: int = 3) -> str:
+    if value is None:
+        return "–"
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            return "–"
+        if abs(value) >= 1000 or (value == int(value) and abs(value) >= 1):
+            return f"{value:,.0f}" if abs(value) >= 1000 else f"{value:g}"
+        return f"{value:.{digits}g}"
+    if isinstance(value, int):
+        return f"{value:,}"
+    return html.escape(str(value))
+
+
+def _table(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> str:
+    head = "".join(f"<th>{html.escape(h)}</th>" for h in headers)
+    body = "".join("<tr>" + "".join(f"<td>{cell}</td>" for cell in row) + "</tr>" for row in rows)
+    return f'<div class="scroll"><table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table></div>'
+
+
+def render_html(document: Mapping[str, Any], pages: Sequence[Page], *, json_name: str = JSON_FILENAME) -> str:
+    """A self-contained HTML page: the runs, their checkpoint tables, the notes and every page as a base64 PNG."""
+    runs = document["runs"]
+    title = str(document["title"])
+    parts = [
+        "<!doctype html>",
+        '<html lang="en"><head><meta charset="utf-8">',
+        '<meta name="viewport" content="width=device-width, initial-scale=1">',
+        "<title>Training history</title>",
+        f"<style>{_CSS}</style></head><body><main>",
+        f"<h1>{html.escape(title)}</h1>",
+        '<p class="sub">Training history read back from each stage directory\'s ledgers '
+        "(eval_episodes.csv, train_episodes.csv, stage_config.json, progress.json, models/). Report only: "
+        f"nothing reads this page back. Generated {html.escape(document['generated_at'])}; the numbers are in "
+        f"<code>{html.escape(json_name)}</code> ({html.escape(SCHEMA)}).</p>",
+        "<nav>" + "".join(f'<a href="#{p.name}">{html.escape(p.title)}</a>' for p in pages) + "</nav>",
+        "<h2>Runs</h2>",
+    ]
+    rows = []
+    for run in runs:
+        sat = run.get("saturation") or {}
+        alarm = sat.get("first_alarm_at")
+        rows.append(
+            [
+                html.escape(str(run["label"])),
+                html.escape(str(run.get("group") or "")),
+                html.escape(str((run.get("model") or {}).get("display") or "–")),
+                _fmt(run.get("seed")),
+                html.escape(str(run.get("status") or "unknown")),
+                _fmt((run["evaluations"].get("timesteps") or [None])[-1]),
+                _fmt(run.get("final_step")),
+                _fmt(sat.get("first_saturated_episode_at")),
+                _fmt(sat.get("first_flagged_at")),
+                f'<span class="alarm">{_fmt(alarm)}</span>' if alarm is not None else "none",
+                "yes" if run.get("band_active") else "no",
+            ]
+        )
+    parts.append(
+        _table(
+            [
+                "run",
+                "group",
+                "model",
+                "seed",
+                "status",
+                "last evaluation",
+                "final",
+                "first saturated episode",
+                "first flagged evaluation",
+                "saturation alarm",
+                "CoP band paid",
+            ],
+            rows,
+        )
+    )
+    parts.append(
+        "<p>Stage directories: "
+        + "; ".join(
+            f"<code>{html.escape(str(run['label']))}</code> = <code>{html.escape(run['stage_dir'])}</code>"
+            for run in runs
+        )
+        + f". Marked checkpoints (J): {', '.join(f'{s:,}' for s in document['marks']['resolved']) or 'none'}.</p>"
+    )
+    parts.append("<h2>At the marked, best and last checkpoints</h2>")
+    parts.append(
+        "<p>Each row reads the evaluation at exactly that step (the final checkpoint, saved after the last "
+        "evaluation, reads the last one). CoP in half-lengths (+ toe), tilt in degrees, lift in mm, left minus "
+        "right in degrees, std in action units at the checkpoint saved at that step.</p>"
+    )
+    for run in runs:
+        table = run.get("checkpoint_table") or []
+        if not table:
+            continue
+        feet = run.get("feet") or []
+        cols: list[tuple[str, str, float]] = [
+            ("episodes", "episodes", 1.0),
+            ("clean", "clean", 1.0),
+            ("falls", "falls", 1.0),
+            ("saturated", "sat. flags", 1.0),
+        ]
+        cols += [(f"{f}_foot_cop_fore_aft", f"foot CoP {f}", 1.0) for f in feet]
+        cols += [(f"{f}_sole_cop_fore_aft", f"pad CoP {f}", 1.0) for f in feet]
+        cols += [("max_sole_tilt_deg", "tilt", 1.0), ("max_sole_corner_lift_m", "lift mm", 1000.0)]
+        cols += [(f"l_minus_r_{j}_deg", f"L-R {j.replace('_', ' ')}", 1.0) for j in LR_JOINTS]
+        cols += [("actuator_force_frac_max", "force frac", 1.0)]
+        std_cols = sorted(
+            {k for row in table for k in row if k.startswith("std_") and k != "std_checkpoint"}, key=_std_order
+        )
+        headers = ["at", "evaluation"] + [c[1] for c in cols] + [k[4:] + " std" for k in std_cols]
+        body = []
+        for row in table:
+            cells = [html.escape(row["at"]), _fmt(row["evaluation_timesteps"])]
+            for key, _, scale in cols:
+                value = row.get(key)
+                cells.append(_fmt(value * scale if isinstance(value, (int, float)) else value))
+            cells += [_fmt(row.get(k)) for k in std_cols]
+            body.append(cells)
+        parts.append(f"<h3>{html.escape(str(run['label']))}</h3>")
+        parts.append(_table(headers, body))
+    parts.append("<h2>What these pages do not show</h2><ul>")
+    parts += [f"<li>{html.escape(note)}</li>" for note in document["not_recorded"]]
+    parts.append("</ul><h2>How the numbers are reduced</h2><ul>")
+    parts += [
+        f"<li><b>{html.escape(key)}</b>: {html.escape(str(value))}</li>" for key, value in document["rules"].items()
+    ]
+    parts.append("</ul>")
+    bars_rows = []
+    for run in runs:
+        bars = run.get("bars") or {}
+        band = run.get("band") or {}
+        bars_rows.append(
+            [html.escape(str(run["label"]))]
+            + [_fmt(bars.get(k)) for k in BAR_KEYS]
+            + [_fmt(band.get(f"{BAND_PREFIX}{k}")) for k in ("weight", "lower", "upper", "pad_lower", "pad_upper")]
+        )
+    parts.append("<h3>Declared bars (stage_config.json curriculum) and the CoP band (reward_weights)</h3>")
+    parts.append(
+        _table(
+            ["run", *BAR_KEYS, "band weight", "band lower", "band upper", "pad band lower", "pad band upper"], bars_rows
+        )
+    )
+    absent_rows = [
+        f"<li><code>{html.escape(str(run['label']))}</code>: {html.escape('; '.join(run.get('absent') or []) or 'nothing')}"
+        + (f' <span class="alarm">errors: {html.escape("; ".join(run["errors"]))}</span>' if run.get("errors") else "")
+        + "</li>"
+        for run in runs
+    ]
+    parts.append("<h3>Absent from these files</h3><ul>" + "".join(absent_rows) + "</ul>")
+    parts.append("<h2>Pages</h2>")
+    for page in pages:
+        encoded = base64.b64encode(page.png).decode("ascii")
+        parts.append(
+            f'<figure id="{page.name}"><img alt="{html.escape(page.title)}" src="data:image/png;base64,{encoded}">'
+            f"<figcaption><b>{html.escape(page.title)}.</b> {html.escape(page.caption)}</figcaption></figure>"
+        )
+    parts.append("</main></body></html>")
+    return "\n".join(parts)
+
+
+def write_report(
+    runs: Sequence[RunHistory],
+    out_dir: "str | Path",
+    *,
+    title: str,
+    marks: Sequence["int | str"] = (),
+    smooth: int = 5,
+    dpi: int = 80,
+) -> dict[str, Any]:
+    """Write *out_dir*'s PNG pages, the HTML page embedding them and the JSON summary; returns what was written.
+
+    The caller has checked that *out_dir* is outside every run directory.
+    """
+    out = Path(out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    document = summary(runs, title=title, marks=marks, smooth=smooth)
+    pages, errors = render_pages(runs, title=title, marks=document["marks"]["resolved"], smooth=smooth, dpi=dpi)
+    document["errors"] = errors
+    document["pages"] = [f"{page.name}.png" for page in pages]
+    written = []
+    for page in pages:
+        path = out / f"{page.name}.png"
+        path.write_bytes(page.png)
+        written.append(path)
+    atomic_write_json(out / JSON_FILENAME, document, indent=None, allow_nan=False)
+    atomic_write_text(out / HTML_FILENAME, render_html(document, pages))
+    return {
+        "html": out / HTML_FILENAME,
+        "json": out / JSON_FILENAME,
+        "pngs": written,
+        "errors": errors,
+        "document": document,
+    }
diff --git a/environments/shared/scripts/plot_training_history.py b/environments/shared/scripts/plot_training_history.py
new file mode 100644
index 00000000..964511e1
--- /dev/null
+++ b/environments/shared/scripts/plot_training_history.py
@@ -0,0 +1,130 @@
+"""Draw one or more stages' training history from their ledgers: PNG pages, an HTML page and a JSON summary.
+
+Reads each stage directory's ``eval_episodes.csv``, ``train_episodes.csv``,
+``stage_config.json``, ``progress.json`` and checkpoint zips
+(:mod:`environments.shared.reporting.training_history`) and writes, into
+``--out``: one PNG per page, ``training_history.html`` (self-contained: the
+pages embedded as base64) and ``training_history.json``
+(``mesozoic.training-history/v1``).  One stage directory gives that run's page
+set; several give the comparison set, one colour per run and one line style
+per ``--groups`` value.  A run that is still training can be drawn from a copy
+of its stage directory at any point.
+
+Report only.  Nothing is written into a run: an ``--out`` inside any run
+directory is refused, as ``plot_gate_progress.py`` refuses it (a result
+bundle's manifest hashes every file there, and verification rejects a file it
+did not list).  The run directory is the nearest ancestor of STAGE_DIR holding
+``provenance.json``; for a copy without one, the stage directory's parent
+(the ``<run>/<NN_stage>`` layout).
+
+Usage::
+
+    python environments/shared/scripts/plot_training_history.py RUN/01_stance --out /tmp/history_s42 \\
+        --mark-steps 4194304 5242880 6291456 8388608 10485760 final
+    python environments/shared/scripts/plot_training_history.py A/01_stance B/01_stance --out /tmp/compare \\
+        --labels a b --groups band control --title "Band against control"
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+from typing import Sequence
+
+_repo_root = str(Path(__file__).resolve().parents[3])
+if _repo_root not in sys.path:
+    sys.path.insert(0, _repo_root)
+
+from environments.shared.scripts.plot_gate_progress import run_directory  # noqa: E402
+
+
+def protected_directories(stage_dir: Path) -> list[Path]:
+    """The directories an output must stay out of: the run directory (by ``provenance.json``, else the layout)."""
+    stage = stage_dir.resolve()
+    run = run_directory(stage)
+    found = [run.resolve()] if run is not None else []
+    found.append(stage.parent)
+    return found
+
+
+def refusal(out: Path, stage_dirs: Sequence[Path]) -> str | None:
+    """Why *out* may not be written, or ``None``: it lies inside one of the stage directories' run directories."""
+    target = out.resolve()
+    for stage in stage_dirs:
+        for protected in protected_directories(stage):
+            if target == protected or target.is_relative_to(protected):
+                return (
+                    f"refusing to write {target} inside the run directory {protected}: the result bundle's manifest "
+                    "(result_bundle/manifest.py) hashes every file there, and verification rejects a file it did not "
+                    "list. Pass an --out outside the run."
+                )
+    return None
+
+
+def _mark(text: str) -> int | str:
+    if text.strip().lower() == "final":
+        return "final"
+    try:
+        return int(text.replace(",", "").replace("_", ""))
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"a mark is a step count or 'final', not {text!r}") from None
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
+    parser.add_argument("stage_dirs", nargs="+", type=Path, metavar="STAGE_DIR", help="a stage directory (read only)")
+    parser.add_argument("--out", type=Path, required=True, help="the directory to write (outside every run)")
+    parser.add_argument("--labels", nargs="+", default=None, help="one label per STAGE_DIR (default: the run name)")
+    parser.add_argument("--groups", nargs="+", default=None, help="one group per STAGE_DIR (one line style each)")
+    parser.add_argument(
+        "--mark-steps", nargs="+", type=_mark, default=[], help="steps to mark (J checkpoints); 'final' for the final"
+    )
+    parser.add_argument("--title", default=None, help="the pages' title")
+    parser.add_argument("--smooth", type=int, default=5, help="comparison pages: rolling mean over N evaluations")
+    parser.add_argument("--dpi", type=int, default=80, help="PNG resolution (default 80)")
+    parser.add_argument("--no-std", action="store_true", help="skip the per-actuator std (no torch import)")
+    args = parser.parse_args(argv)
+    stage_dirs = [path.resolve() for path in args.stage_dirs]
+    for name, values in (("--labels", args.labels), ("--groups", args.groups)):
+        if values is not None and len(values) != len(stage_dirs):
+            parser.error(f"{name} needs one value per STAGE_DIR ({len(stage_dirs)}), got {len(values)}")
+    reason = refusal(args.out, stage_dirs)
+    if reason is not None:
+        print(reason, file=sys.stderr)
+        return 2
+    missing = [str(path) for path in stage_dirs if not path.is_dir()]
+    if missing:
+        print(f"no such stage directory: {', '.join(missing)}", file=sys.stderr)
+        return 1
+
+    from environments.shared.reporting import training_history
+
+    if len(stage_dirs) > training_history.MAX_RUNS:
+        print(f"at most {training_history.MAX_RUNS} stage directories per comparison", file=sys.stderr)
+        return 1
+    runs = [
+        training_history.load_run_history(
+            stage,
+            label=args.labels[i] if args.labels else None,
+            group=args.groups[i] if args.groups else None,
+            read_std=not args.no_std,
+        )
+        for i, stage in enumerate(stage_dirs)
+    ]
+    title = args.title
+    if title is None:
+        first = runs[0]
+        model = first.model_display or "training history"
+        title = f"{model}: {first.label}" if len(runs) == 1 else f"{model}: {', '.join(run.label for run in runs)}"
+    written = training_history.write_report(
+        runs, args.out, title=title, marks=args.mark_steps, smooth=args.smooth, dpi=args.dpi
+    )
+    for error in written["errors"]:
+        print(f"warning: {error}", file=sys.stderr)
+    print(written["html"])
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

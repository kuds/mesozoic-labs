 # ------------------------------------------------------------------------------------------------ PROVISIONAL / final
+def _pins_stub(root, scorer_sha=None, override=None, drop=()):
+    """A stub criteria text whose PINS section names SCREEN.json and every pinned tool at its current sha256 (the
+    scorer checks every PINS line: fixer P-m2); override {path: hex} replaces lines, drop removes them."""
+    lines = {"SCREEN.json": _sha(root / "SCREEN.json"), **{f"tools/{t}": _sha(TOOLS / t) for t in SB.PINNED_TOOLS}}
+    if scorer_sha:
+        lines["tools/score_bs.py"] = scorer_sha
+    lines.update(override or {})
+    body = "".join(f"    {k:<36} {v}\n" for k, v in lines.items() if k not in drop)
+    return "criteria ...\nPINS (stub)\n" + body + "HOW THE COORDINATOR PINS (stub)\n"
+
+

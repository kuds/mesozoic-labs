+# ------------------------------------------------------------------------------------------------ fixer additions
+def _pins_root(tmp_path, approve=True, **kw):
+    Screen(tmp_path)
+    (tmp_path / "criteria.txt").write_text(_pins_stub(tmp_path, **kw))
+    if approve:
+        appr = {"criteria_sha256": _sha(tmp_path / "criteria.txt"), "screen_sha256": _sha(tmp_path / "SCREEN.json"),
+                "code_tree_digest": C.TREE_DIGEST, "tool_sha256": {t: _sha(TOOLS / t) for t in SB.PINNED_TOOLS},
+                "approved_by": "test"}
+        _write(tmp_path / "APPROVED", appr)
+    return [x for x in SB.provisional_items(tmp_path, [], {}) if not x.startswith("M5 pin")]
+
+
+def test_pins_lines_hold_when_every_line_is_current(tmp_path):
+    """Fixer P-m2: with every PINS line current and APPROVED pinning the same files, no PINS item."""
+    assert _pins_root(tmp_path) == []
+
+
+@pytest.mark.parametrize("kw, match", [
+    ({"override": {"tools/bs_hooks.py": "0" * 64}}, "criteria.txt PINS: tools/bs_hooks.py 0000"),   # review M6
+    ({"drop": ("tools/read_bs.py",)}, "0 lines name tools/read_bs.py"),
+    ({"override": {"SCREEN.json": "1" * 64}}, "criteria.txt PINS: SCREEN.json 1111"),
+    ({"override": {"tools/tests/test_score_bs.py": "2" * 64}}, "criteria.txt PINS: tools/tests/test_score_bs.py"),
+])
+def test_pins_lines_stale_or_missing_are_provisional(tmp_path, kw, match):
+    """Fixer P-m2 (the process review's case M6: a tool changed and re-pinned in APPROVED with a stale PINS line):
+    every 64-hex PINS line must name its file's current sha256; the pinned tools and SCREEN.json need one line each."""
+    items = _pins_root(tmp_path, **kw)
+    assert [x for x in items if match in x], items
+
+
+def test_pins_line_against_approved_and_no_section(tmp_path):
+    """Fixer P-m2: a PINS line equal to the file but not to APPROVED's pin is an item; so is a text without PINS."""
+    Screen(tmp_path)
+    (tmp_path / "criteria.txt").write_text(_pins_stub(tmp_path))
+    tools = {t: _sha(TOOLS / t) for t in SB.PINNED_TOOLS}
+    tools["run_bs.py"] = "3" * 64
+    _write(tmp_path / "APPROVED", {"criteria_sha256": _sha(tmp_path / "criteria.txt"),
+                                   "screen_sha256": _sha(tmp_path / "SCREEN.json"), "code_tree_digest": C.TREE_DIGEST,
+                                   "tool_sha256": tools, "approved_by": "test"})
+    items = SB.provisional_items(tmp_path, [], {})
+    assert [x for x in items if x.startswith("criteria.txt PINS: tools/run_bs.py") and "APPROVED's" in x], items
+    (tmp_path / "criteria.txt").write_text(f"no section here; tools/score_bs.py {_sha(TOOLS / 'score_bs.py')}\n")
+    assert "criteria.txt has no PINS section" in SB.provisional_items(tmp_path, [], {})
+    assert SB.pins_lines("x\nPINS\n    tools/a.py  " + "a" * 64 + " [note]\n    b.txt " + "b" * 64 + "\n") == {
+        "b.txt": ["b" * 64]}
+
+
+def test_guard_missing_note():
+    """Fixer, design I3: with any MISSING value the guard cannot warn (its filled p >= 36/70); it says so.  The
+    efficacy secondaries never carry the note; with nothing missing the guard does not either."""
+    cl = _classes()
+    base = {C.run_name(a, sd): Fraction(1 if a == CTRL else 2) + Fraction(i, 64) for i, (a, sd) in enumerate(SB.QUEUE)}
+    t = SB.secondary_test(SB.SECONDARIES[3], cl, base, {}, 2)
+    assert t["supported"] and t["notes"] == [SB.SEC_GUARD]
+    for miss in (C.run_name(PHASE, 2931), C.run_name(CTRL, 2901)):
+        vals = {**base, miss: None}
+        t = SB.secondary_test(SB.SECONDARIES[3], cl, vals, {miss: "LOST"}, 2)
+        assert not t["supported"] and t["filled"][1] >= 36 and t["notes"] == [SB.SEC_GUARD_MISSING]
+        t1 = SB.secondary_test(SB.SECONDARIES[3], cl, vals, {miss: "LOST"}, 1)
+        assert t1["notes"] == [SB.SEC_GUARD_MISSING, SB.SEC_UNDER_LINE1]
+        for spec in SB.SECONDARIES[:3]:
+            assert SB.SEC_GUARD_MISSING not in SB.secondary_test(spec, cl, vals, {miss: "LOST"}, 2)["notes"]
+
+
+def test_slope_end_vs_start_report_only(tmp_path):
+    """Fixer, design D2 (report only): per continuation the effective on-policy slope at E minus at S and the counts
+    E <= S and E <= 0 per arm; the reading, the secondaries and the PROVISIONAL list do not depend on it."""
+    _main_screen(tmp_path)
+    res, text, _ = _score(tmp_path)
+    for arm in (CTRL, PHASE):
+        for i, seed in enumerate(SB.SEEDS):
+            r = res["report_only"][C.run_name(arm, seed)]["slope_end_vs_start"]
+            e = SEC_MECH[arm][i]
+            assert r == {"S": 0.01, "E": e, "E_minus_S": e - 0.01, "E_le_S": e <= 0.01, "E_le_0": e <= 0.0}
+    assert res["slope_end_vs_start"] == {CTRL: {"E_le_S": 0, "E_le_0": 0, "of": 4},
+                                         PHASE: {"E_le_S": 3, "E_le_0": 2, "of": 4}}
+    assert "REPORT ONLY, THE CRITIC'S ON-POLICY TAIL SLOPE AT E AGAINST S" in text
+    assert f"{PHASE} E <= S 3 of 4, E <= 0 2 of 4" in text
+    m = {"loop": [{"steps": C.S, "critic_slope_obs6": {"ONPOLICY": {"effective": {"dV_dq3_per_deg": 0.02}}}}]}
+    assert SB.slope_end_vs_start(m) is None                                   # no row at E

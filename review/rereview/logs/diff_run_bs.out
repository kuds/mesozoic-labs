+def redirect_tensorboard(model: Any, tb_dir: Any) -> dict:
+    """Fixer P-B1: the start zip's saved data carries tensorboard_log = an absolute /tmp/tb_buffer/... path (the
+    parent's Colab buffer); with use_tensorboard=False the body leaves tensorboard_log out of the load's kwargs, so
+    SB3's load keeps that path and learn()'s _setup_learn would write the events file (outcome-bearing scalars) there,
+    OUTSIDE <BS>.  Point it at tb_dir (the run's own TMPDIR/tb, under <BS>/tmp/) before learn(): the logger is built
+    exactly as before (verbose 0: the tensorboard format only; reset_num_timesteps False in an empty folder: PPO_0),
+    only its folder moves.  Refused unless tb_dir is under <BS>/tmp/.  Returns the record for run_meta."""
+    root = os.path.realpath(bs_root() / "tmp")
+    target = os.path.realpath(tb_dir)
+    if not target.startswith(root + os.sep):
+        raise Refused(f"tensorboard: {target} is not under {root}")
+    old = getattr(model, "tensorboard_log", None)
+    model.tensorboard_log = target
+    return {"loaded": old, "set": target}
+
+
+def end_phase_problems(state: dict) -> list[str]:
+    """Fixer P-i3: critic_phase at the run's end (after the last update, which no per-rollout evidence follows): the
+    actor's phase columns must still equal those at the load and their Adam moments must still be exactly 0
+    (bs_hooks.phase_state against the reference taken after install_arm).  [] or the reasons."""
+    p = []
+    if state.get("policy_phase_cols_unchanged") is not True:
+        p.append("the actor's phase columns (policy_net.0.weight[:, 60:63]) changed by the end")
+    if state.get("policy_phase_adam_max_abs") != 0.0:
+        got = state.get("policy_phase_adam_max_abs")
+        p.append(f"the actor's phase-column Adam moments at the end: max |.| {got!r}, not 0")
+    return p
+
+

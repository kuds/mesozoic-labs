     return v if isinstance(v, str) and HEX64.fullmatch(v) else None
 
 
+PINS_LINE = re.compile(r"^[ \t]+([\w.-]+(?:/[\w.-]+)*)[ \t]+([0-9a-f]{64})[ \t]*$", re.M)
+
+
+def pins_lines(text):
+    """{path: [64-hex, ...]} from criteria.txt's PINS section (from the line starting "PINS" to the line starting
+    "HOW THE COORDINATOR PINS"): every line that is a path and a bare 64-hex sha256; None without the section."""
+    parts = text.split("\nPINS", 1)
+    if len(parts) != 2:
+        return None
+    out = {}
+    for m in PINS_LINE.finditer(parts[1].split("\nHOW THE COORDINATOR PINS", 1)[0]):
+        out.setdefault(m.group(1), []).append(m.group(2))
+    return out
+
+
+def pins_items(text, root, screen_sha, tool_now, approved_pins):
+    """Fixer P-m2 (criteria WHEN THE READING IS MADE): criteria.txt's PINS lines must hold.  SCREEN.json, the five
+    harness tools and this scorer each need exactly one line, equal to the file's current sha256 and, when APPROVED
+    exists, to APPROVED's tool_sha256; any other 64-hex PINS line (tools/tests/test_score_bs.py) must equal its file's
+    current sha256.  [] or the items."""
+    lines = pins_lines(text)
+    if lines is None:
+        return ["criteria.txt has no PINS section"]
+    items = []
+    required = {f"tools/{t}": tool_now[t] for t in PINNED_TOOLS}
+    required["SCREEN.json"] = screen_sha
+    for rel, now in required.items():
+        got = lines.get(rel, [])
+        if len(got) != 1:
+            items.append(f"criteria.txt PINS: {len(got)} lines name {rel}, not 1")
+        elif got[0] != now:
+            items.append(f"criteria.txt PINS: {rel} {got[0]} != the file's current sha256 {now}")
+        elif approved_pins is not None and rel.startswith("tools/") and got[0] != approved_pins.get(rel[6:]):
+            items.append(f"criteria.txt PINS: {rel} {got[0]} != APPROVED's {approved_pins.get(rel[6:])!r}")
+    for rel, got in sorted(lines.items()):
+        if rel in required:
+            continue
+        path = TOOLS.parent / rel if rel.startswith("tools/") else Path(root) / rel
+        try:
+            now = C.sha256_file(path)
+        except OSError:
+            now = None
+        if got != [now]:
+            items.append(f"criteria.txt PINS: {rel} {got} != the file's current sha256 {now}")
+    return items
+
+

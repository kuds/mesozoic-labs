+# the start pair's effective on-policy critic slope per degree (every continuation starts there; V3:
+# validate/logs/v3_check.out, <BS2>/score/score.txt line 87): printed beside each continuation's own S row
+SLOPE_ONPOLICY_AT_S = 0.02142920531332493
+SLOPE_KEY = ("critic_slope_obs6", "ONPOLICY", "effective", "dV_dq3_per_deg")
+
+
+def slope_end_vs_start(m):
+    """Fixer, design D2 (report only, never tested): the effective critic's mean dV/dq3 per degree on the reader's
+    on-policy states at the loop row at E minus at the loop row at S (the start pair), and whether slope(E) <= slope(S)
+    and slope(E) <= 0 -- what SEC-MECH (phase against control at E) cannot show: whether the phase arm's critic stopped
+    paying for the tail, rather than paying less than control's.  None if either row or value is absent."""
+    rs, re_ = loop_rows_at(m, C.S), loop_rows_at(m, C.E)
+    if len(rs) != 1 or len(re_) != 1:
+        return None
+    s, e = _get(rs[0], *SLOPE_KEY), _get(re_[0], *SLOPE_KEY)
+    if not (_finite(s) and _finite(e)):
+        return None
+    return {"S": s, "E": e, "E_minus_S": e - s, "E_le_S": e <= s, "E_le_0": e <= 0.0}
+
+

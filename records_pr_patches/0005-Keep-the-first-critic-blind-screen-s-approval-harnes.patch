+        raise InputError(f"{path}: bank rows {ss} are {[labels[i] for i in ss]}, not statue_settled")
+    steps = np.asarray(cols["update_timesteps"]).astype(np.int64)
+    idx = [i for i, u in enumerate(steps.tolist()) if S < int(u) < T]

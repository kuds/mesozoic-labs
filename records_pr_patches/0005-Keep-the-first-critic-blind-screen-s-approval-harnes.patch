+def probe_markers(path, S, T, label):
+    import numpy as np
+
+    keys = ("update_timesteps", "bank_action_now", "bank_value_now", "obs_rms_mean", "obs_rms_var",
+            "std_per_actuator", "rollout_mu_mean", "bank_labels")

+        if len(pts) >= 2:
+            x = np.array([p[0] for p in pts])
+            y = np.array([p[1] for p in pts])
+            sl = float(np.polyfit(x, y, 1)[0])
+            gs.append(1.0 - 1.0 / sl)
+            ns.append(len(pts))
+    if gs:

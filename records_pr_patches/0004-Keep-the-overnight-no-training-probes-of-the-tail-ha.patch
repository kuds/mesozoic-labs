+                    tt.sort(key=lambda z: -abs(z[0]))
+                    o["regions"][f"{tname}_{rn}_{j}"] = {"n_rows_mean": float(np.mean([x["n"] for x in b])), "pg": pg, "kl": kl,
+                                                         "terms_gae_sb": {k: g for _, k, g in tt}}

+    assert mar["p_filled"]["p_float"] == pytest.approx(_brute_p(SEC_B[BLIND], SEC_B[C.CONTROL]))
+    for key, vals in (("SEC-G", SEC_G), ("SEC-CMD", SEC_CMD), ("SEC-MARGIN", SEC_B)):

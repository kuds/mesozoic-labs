+    """The seeds a continuation uses: model and training env 0 (seed), envs 1-3 (seed + rank), eval (seed + 1000)."""
+    return (*(int(seed) + r for r in range(N_ENVS)), int(seed) + EVAL_SEED_OFFSET)

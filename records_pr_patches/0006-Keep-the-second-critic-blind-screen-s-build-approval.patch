+for name, idx in (("at S", bs_rows), ("at E", prim_rows)):
+    v = mu[idx].astype(np.float64)
+    print(f"row SD {name}: {v.std(ddof=1):.5f} (SE of the 8-row mean if rows were independent "
+          f"{v.std(ddof=1) / math.sqrt(8):.5f})")

+def load_lost(path):
+    path = Path(path)
+    if not path.exists():
+        return {}
+    d, _ = read_json_file(path)
+    if d.get("schema") != C.LOST_SCHEMA or not isinstance(d.get("lost"), dict):
+        raise InputError(f"{path}: schema {d.get('schema')!r}")
+    return dict(d["lost"])

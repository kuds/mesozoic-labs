+    """Probe rows with update_timesteps in (S, T): (T - S)/8,192 - 1 (175 at E)."""
+    if (T - S_) % ROLLOUT or T <= S_:
+        raise ValueError(f"T - S = {T - S_} is not a positive multiple of {ROLLOUT}")
+    return (T - S_) // ROLLOUT - 1

++    assert RB.cache_key(z, p, blind=False, onpolicy=True, own=True, deps="d" * 64) != k
++    assert RB.cache_key(z, p, blind=True, onpolicy=True, own=True) != k
++    assert RB.cache_key(z, p, blind=False, onpolicy=False, own=True) != k

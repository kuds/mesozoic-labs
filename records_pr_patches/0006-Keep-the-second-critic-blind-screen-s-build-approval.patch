+def loop_markers(pairs, *, blind, onpolicy, own, tag):
+    """M-LOOP over pairs, with the cache under <BS>/reads/_cache/."""
+    import numpy as np
+
+    from environments.shared.config import load_stage_config
+    from environments.shared.model_id import ModelId

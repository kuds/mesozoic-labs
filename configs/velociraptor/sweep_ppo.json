{
  "_comment": "Velociraptor PPO sweep — bipedal predator with claw-based strike",

  "stage1": {
    "trials": 30,
    "timesteps": 6000000,
    "parallel": 9,
    "n_envs": 4,

    "ppo_learning_rate":       {"type": "double", "min": 1e-5, "max": 3e-4, "scale": "log"},
    "ppo_ent_coef":            {"type": "double", "min": 1e-4, "max": 0.05, "scale": "log"},
    "ppo_batch_size":          {"type": "discrete", "values": [64, 128, 256]},
    "ppo_gamma":               {"type": "double", "min": 0.97, "max": 0.999, "scale": "linear"},
    "ppo_n_steps":             {"type": "discrete", "values": [1024, 2048, 4096]},
    "ppo_n_epochs":            {"type": "discrete", "values": [3, 6, 10]},

    "_comment_env": "Bipedal balance: high nosedive weight due to forward-leaning anatomy",
    "env_alive_bonus":              {"type": "double", "min": 1.0, "max": 2.5, "scale": "linear"},
    "env_posture_weight":           {"type": "double", "min": 1.0, "max": 2.5, "scale": "linear"},
    "env_nosedive_weight":          {"type": "double", "min": 1.0, "max": 2.5, "scale": "linear"},
    "env_drift_penalty_weight":     {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_speed_penalty_weight":     {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_spin_penalty_weight":      {"type": "double", "min": 0.0, "max": 0.3, "scale": "linear"},
    "env_energy_penalty_weight":    {"type": "double", "min": 0.01, "max": 0.1, "scale": "log"},
    "env_tail_stability_weight":    {"type": "double", "min": 0.0, "max": 0.1, "scale": "linear"}
  },

  "stage2": {
    "trials": 40,
    "timesteps": 8000000,
    "parallel": 9,
    "n_envs": 4,

    "ppo_learning_rate":       {"type": "double", "min": 1e-5, "max": 3e-4, "scale": "log"},
    "ppo_ent_coef":            {"type": "double", "min": 1e-4, "max": 0.05, "scale": "log"},
    "ppo_batch_size":          {"type": "discrete", "values": [64, 128, 256, 512]},
    "ppo_gamma":               {"type": "double", "min": 0.97, "max": 0.999, "scale": "linear"},
    "ppo_n_steps":             {"type": "discrete", "values": [1024, 2048, 4096]},
    "ppo_n_epochs":            {"type": "discrete", "values": [3, 6, 10]},

    "_comment_env": "Bipedal locomotion: higher velocity cap than Brachiosaurus, no gait symmetry needed",
    "env_forward_vel_weight":       {"type": "double", "min": 1.0, "max": 3.5, "scale": "linear"},
    "env_forward_vel_max":          {"type": "double", "min": 2.0, "max": 4.0, "scale": "linear"},
    "env_alive_bonus":              {"type": "double", "min": 0.2, "max": 0.75, "scale": "linear"},
    "env_posture_weight":           {"type": "double", "min": 0.05, "max": 0.4, "scale": "linear"},
    "env_nosedive_weight":          {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_heading_weight":           {"type": "double", "min": 0.0, "max": 0.5, "scale": "linear"},
    "env_lateral_penalty_weight":   {"type": "double", "min": 0.0, "max": 0.2, "scale": "linear"},
    "env_energy_penalty_weight":    {"type": "double", "min": 0.001, "max": 0.01, "scale": "log"},
    "env_tail_stability_weight":    {"type": "double", "min": 0.0, "max": 0.1, "scale": "linear"},

    "curriculum_warmup_timesteps":  {"type": "discrete", "values": [50000, 100000, 200000, 300000]},
    "curriculum_warmup_clip_range": {"type": "double", "min": 0.01, "max": 0.05, "scale": "linear"},
    "curriculum_warmup_ent_coef":   {"type": "double", "min": 0.005, "max": 0.05, "scale": "log"},
    "curriculum_ramp_timesteps":    {"type": "discrete", "values": [200000, 500000, 1000000, 2000000]},
    "curriculum_ramp_start_value":  {"type": "double", "min": 0.05, "max": 0.3, "scale": "linear"}
  },

  "stage3": {
    "_comment": "Strike: sprint toward prey and strike with sickle claw",
    "trials": 50,
    "timesteps": 10000000,
    "parallel": 9,
    "n_envs": 4,

    "ppo_learning_rate":       {"type": "double", "min": 1e-5, "max": 3e-4, "scale": "log"},
    "ppo_ent_coef":            {"type": "double", "min": 1e-4, "max": 0.05, "scale": "log"},
    "ppo_batch_size":          {"type": "discrete", "values": [64, 128, 256, 512]},
    "ppo_gamma":               {"type": "double", "min": 0.97, "max": 0.999, "scale": "linear"},
    "ppo_n_steps":             {"type": "discrete", "values": [1024, 2048, 4096]},
    "ppo_n_epochs":            {"type": "discrete", "values": [3, 6, 10]},

    "_comment_strike": "Strike reward: sweep the sparse bonus and approach shaping",
    "env_strike_bonus":                 {"type": "double", "min": 40.0, "max": 150.0, "scale": "log"},
    "env_strike_approach_weight":       {"type": "double", "min": 1.0, "max": 5.0, "scale": "linear"},
    "env_strike_claw_proximity_weight": {"type": "double", "min": 0.5, "max": 2.0, "scale": "linear"},

    "_comment_locomotion": "Locomotion: enough to sprint toward prey",
    "env_forward_vel_weight":           {"type": "double", "min": 0.5, "max": 2.0, "scale": "linear"},
    "env_forward_vel_max":              {"type": "double", "min": 2.0, "max": 4.0, "scale": "linear"},
    "env_heading_weight":               {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_lateral_penalty_weight":       {"type": "double", "min": 0.0, "max": 0.2, "scale": "linear"},
    "env_nosedive_weight":              {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},

    "_comment_spawning": "Prey spawning: sweep distance for reward density",
    "env_prey_distance_min":            {"type": "double", "min": 1.5, "max": 3.0, "scale": "linear"},
    "env_prey_distance_max":            {"type": "double", "min": 5.0, "max": 8.0, "scale": "linear"},

    "curriculum_warmup_timesteps":      {"type": "discrete", "values": [50000, 100000, 200000, 300000]},
    "curriculum_warmup_clip_range":     {"type": "double", "min": 0.01, "max": 0.05, "scale": "linear"},
    "curriculum_warmup_ent_coef":       {"type": "double", "min": 0.005, "max": 0.05, "scale": "log"},
    "curriculum_ramp_timesteps":        {"type": "discrete", "values": [500000, 1000000, 2000000, 4000000]},
    "curriculum_ramp_start_value":      {"type": "double", "min": 0.05, "max": 0.3, "scale": "linear"}
  }
}

{
  "_comment": "Dibothrosuchus SAC sweep — small gracile crocodylomorph with an erect quadrupedal gait and a snout-snap task. No run history exists for this species yet, so every range brackets the committed stage TOML value rather than a measured optimum.",

  "stage1": {
    "_comment": "Erect quadrupedal balance. The zero-action baseline at reset_noise=0.14 scores 1605 mean / 324 mean-std / 62% full-horizon.",
    "trials": 15,
    "timesteps": 6000000,
    "parallel": 6,
    "n_envs": 8,

    "sac_learning_rate":  {"type": "double", "min": 5e-5, "max": 5e-4, "scale": "log"},
    "sac_batch_size":     {"type": "discrete", "values": [128, 256, 512]},
    "sac_gamma":          {"type": "double", "min": 0.985, "max": 0.995, "scale": "linear"},
    "sac_buffer_size":    {"type": "discrete", "values": [300000, 500000, 1000000]},
    "sac_tau":            {"type": "double", "min": 0.001, "max": 0.01, "scale": "log"},
    "sac_train_freq":     {"type": "discrete", "values": [4, 8, 16]},
    "sac_gradient_steps": {"type": "discrete", "values": [4, 8, 16]},

    "_comment_env": "The zero-action failure mode is a roll into a sprawl, so posture and height dominate",
    "env_alive_bonus":              {"type": "double", "min": 1.0, "max": 2.5, "scale": "linear"},
    "env_posture_weight":           {"type": "double", "min": 1.0, "max": 2.5, "scale": "linear"},
    "env_height_weight":            {"type": "double", "min": 0.5, "max": 1.5, "scale": "linear"},
    "env_nosedive_weight":          {"type": "double", "min": 0.5, "max": 1.5, "scale": "linear"},
    "env_energy_penalty_weight":    {"type": "double", "min": 0.01, "max": 0.1, "scale": "log"},
    "env_speed_penalty_weight":     {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_gait_stability_weight":    {"type": "double", "min": 0.02, "max": 0.15, "scale": "linear"}
  },

  "stage2": {
    "_comment": "Diagonal-pair walk. SAC's replay buffer should suit a gait task; the open question is how much symmetry shaping the plant needs.",
    "trials": 20,
    "timesteps": 10000000,
    "parallel": 6,
    "n_envs": 8,

    "sac_learning_rate":  {"type": "double", "min": 5e-5, "max": 3e-4, "scale": "log"},
    "sac_batch_size":     {"type": "discrete", "values": [256, 512]},
    "sac_gamma":          {"type": "double", "min": 0.985, "max": 0.995, "scale": "linear"},
    "sac_buffer_size":    {"type": "discrete", "values": [500000, 1000000]},
    "sac_tau":            {"type": "double", "min": 0.001, "max": 0.01, "scale": "log"},
    "sac_train_freq":     {"type": "discrete", "values": [4, 8, 16]},
    "sac_gradient_steps": {"type": "discrete", "values": [4, 8, 16]},

    "_comment_env": "Locomotion shaping",
    "env_forward_vel_weight":       {"type": "double", "min": 1.5, "max": 4.5, "scale": "linear"},
    "env_forward_vel_max":          {"type": "double", "min": 1.5, "max": 3.0, "scale": "linear"},
    "env_alive_bonus":              {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_gait_symmetry_weight":     {"type": "double", "min": 0.5, "max": 3.0, "scale": "linear"},
    "env_gait_stability_weight":    {"type": "double", "min": 0.02, "max": 0.12, "scale": "linear"},
    "env_idle_penalty_weight":      {"type": "double", "min": 0.1, "max": 0.4, "scale": "linear"},
    "env_posture_weight":           {"type": "double", "min": 0.15, "max": 0.6, "scale": "linear"},
    "env_nosedive_weight":          {"type": "double", "min": 0.4, "max": 1.2, "scale": "linear"},
    "env_energy_penalty_weight":    {"type": "double", "min": 0.002, "max": 0.008, "scale": "log"}
  },

  "stage3": {
    "_comment": "Snout snap. Auto-entropy is the reason to try SAC here: the 0.06 m prey sphere makes this the sparsest stage-3 target in the repository.",
    "trials": 25,
    "timesteps": 8000000,
    "parallel": 6,
    "n_envs": 8,

    "sac_learning_rate":  {"type": "double", "min": 5e-5, "max": 3e-4, "scale": "log"},
    "sac_batch_size":     {"type": "discrete", "values": [256, 512]},
    "sac_gamma":          {"type": "double", "min": 0.985, "max": 0.995, "scale": "linear"},
    "sac_buffer_size":    {"type": "discrete", "values": [500000, 1000000]},
    "sac_tau":            {"type": "double", "min": 0.001, "max": 0.01, "scale": "log"},
    "sac_train_freq":     {"type": "discrete", "values": [4, 8, 16]},
    "sac_gradient_steps": {"type": "discrete", "values": [4, 8, 16]},

    "_comment_env": "Snap shaping and the nosedive tradeoff",
    "env_snap_bonus":                    {"type": "double", "min": 500.0, "max": 2000.0, "scale": "log"},
    "env_snap_approach_weight":          {"type": "double", "min": 1.5, "max": 5.0, "scale": "linear"},
    "env_snap_snout_proximity_weight":   {"type": "double", "min": 0.5, "max": 4.0, "scale": "linear"},
    "env_forward_vel_weight":            {"type": "double", "min": 0.1, "max": 0.8, "scale": "linear"},
    "env_heading_weight":                {"type": "double", "min": 0.3, "max": 0.8, "scale": "linear"},
    "env_nosedive_weight":               {"type": "double", "min": 0.03, "max": 0.3, "scale": "log"},
    "env_fall_penalty":                  {"type": "double", "min": -20.0, "max": -5.0, "scale": "linear"}
  }
}

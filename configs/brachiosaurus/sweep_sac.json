{
  "_comment": "Brachiosaurus SAC sweep — quadrupedal herbivore with neck-based food reach",

  "stage1": {
    "trials": 15,
    "timesteps": 6000000,
    "parallel": 6,
    "n_envs": 8,

    "sac_learning_rate":  {"type": "double", "min": 5e-5, "max": 5e-4, "scale": "log"},
    "sac_batch_size":     {"type": "discrete", "values": [128, 256, 512]},
    "sac_gamma":          {"type": "double", "min": 0.985, "max": 0.995, "scale": "linear"},
    "sac_buffer_size":    {"type": "discrete", "values": [300000, 500000, 1000000]},
    "sac_tau":            {"type": "double", "min": 0.001, "max": 0.01, "scale": "log"},
    "sac_train_freq":     {"type": "discrete", "values": [4, 8, 16]},
    "sac_gradient_steps": {"type": "discrete", "values": [4, 8, 16]},

    "_comment_env": "Quadrupedal balance: lower nosedive weight than bipeds, gait stability matters",
    "env_alive_bonus":              {"type": "double", "min": 1.0, "max": 3.0, "scale": "linear"},
    "env_posture_weight":           {"type": "double", "min": 1.0, "max": 2.5, "scale": "linear"},
    "env_nosedive_weight":          {"type": "double", "min": 0.2, "max": 0.5, "scale": "linear"},
    "env_energy_penalty_weight":    {"type": "double", "min": 0.01, "max": 0.1, "scale": "log"},
    "env_speed_penalty_weight":     {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_gait_stability_weight":    {"type": "double", "min": 0.05, "max": 0.2, "scale": "linear"}
  },

  "stage2": {
    "trials": 20,
    "timesteps": 10000000,
    "parallel": 6,
    "n_envs": 8,

    "sac_learning_rate":  {"type": "double", "min": 5e-5, "max": 3e-4, "scale": "log"},
    "sac_batch_size":     {"type": "discrete", "values": [128, 256, 512]},
    "sac_gamma":          {"type": "double", "min": 0.985, "max": 0.995, "scale": "linear"},
    "sac_buffer_size":    {"type": "discrete", "values": [500000, 1000000, 2000000]},
    "sac_tau":            {"type": "double", "min": 0.001, "max": 0.01, "scale": "log"},
    "sac_train_freq":     {"type": "discrete", "values": [4, 8, 16]},
    "sac_gradient_steps": {"type": "discrete", "values": [4, 8, 16]},

    "_comment_env": "Quadrupedal locomotion: slower velocity cap, gait symmetry is critical for diagonal coordination",
    "env_forward_vel_weight":       {"type": "double", "min": 2.0, "max": 5.0, "scale": "linear"},
    "env_forward_vel_max":          {"type": "double", "min": 0.6, "max": 1.25, "scale": "linear"},
    "env_alive_bonus":              {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_gait_symmetry_weight":     {"type": "double", "min": 1.5, "max": 3.0, "scale": "linear"},
    "env_gait_stability_weight":    {"type": "double", "min": 0.03, "max": 0.1, "scale": "linear"},
    "env_nosedive_weight":          {"type": "double", "min": 0.5, "max": 1.5, "scale": "linear"},
    "env_idle_penalty_weight":      {"type": "double", "min": 0.1, "max": 0.4, "scale": "linear"},
    "env_posture_weight":           {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_height_weight":            {"type": "double", "min": 0.05, "max": 0.3, "scale": "linear"},
    "env_tail_stability_weight":    {"type": "double", "min": 0.05, "max": 0.2, "scale": "linear"},
    "env_energy_penalty_weight":    {"type": "double", "min": 0.001, "max": 0.01, "scale": "log"},

    "curriculum_ramp_timesteps":    {"type": "discrete", "values": [200000, 500000, 1000000, 2000000]},
    "curriculum_ramp_start_value":  {"type": "double", "min": 0.05, "max": 0.3, "scale": "linear"}
  },

  "stage3": {
    "_comment": "Food reach: walk to food and extend neck to reach",
    "trials": 25,
    "timesteps": 10000000,
    "parallel": 6,
    "n_envs": 8,

    "sac_learning_rate":  {"type": "double", "min": 5e-5, "max": 3e-4, "scale": "log"},
    "sac_batch_size":     {"type": "discrete", "values": [256, 512]},
    "sac_gamma":          {"type": "double", "min": 0.985, "max": 0.995, "scale": "linear"},
    "sac_buffer_size":    {"type": "discrete", "values": [1000000, 2000000]},
    "sac_tau":            {"type": "double", "min": 0.001, "max": 0.01, "scale": "log"},
    "sac_train_freq":     {"type": "discrete", "values": [8, 16]},
    "sac_gradient_steps": {"type": "discrete", "values": [8, 16]},

    "_comment_food": "Food reach: sweep the sparse bonus and shaping signals",
    "env_food_reach_bonus":            {"type": "double", "min": 50.0, "max": 200.0, "scale": "log"},
    "env_food_reach_threshold":        {"type": "double", "min": 0.6, "max": 1.0, "scale": "linear"},
    "env_food_approach_weight":        {"type": "double", "min": 2.0, "max": 5.0, "scale": "linear"},
    "env_food_head_proximity_weight":  {"type": "double", "min": 1.0, "max": 4.0, "scale": "linear"},

    "_comment_locomotion": "Locomotion: minimal — just enough to walk to food",
    "env_forward_vel_weight":       {"type": "double", "min": 0.1, "max": 0.5, "scale": "linear"},
    "env_heading_weight":           {"type": "double", "min": 0.3, "max": 0.8, "scale": "linear"},
    "env_lateral_penalty_weight":   {"type": "double", "min": 0.1, "max": 0.4, "scale": "linear"},

    "_comment_posture": "Posture: low nosedive to allow neck extension for reaching",
    "env_nosedive_weight":          {"type": "double", "min": 0.03, "max": 0.2, "scale": "log"},
    "env_posture_weight":           {"type": "double", "min": 0.05, "max": 0.2, "scale": "linear"},
    "env_fall_penalty":             {"type": "double", "min": -20.0, "max": -5.0, "scale": "linear"},
    "env_energy_penalty_weight":    {"type": "double", "min": 0.0005, "max": 0.002, "scale": "log"},

    "_comment_spawning": "Food spawning: closer food = denser reward signal for reach discovery",
    "env_food_distance_range_min":  {"type": "double", "min": 1.0, "max": 2.0, "scale": "linear"},
    "env_food_distance_range_max":  {"type": "double", "min": 3.0, "max": 5.0, "scale": "linear"},
    "env_food_height_range_min":    {"type": "double", "min": 1.5, "max": 2.5, "scale": "linear"},
    "env_food_height_range_max":    {"type": "double", "min": 3.0, "max": 4.0, "scale": "linear"},

    "curriculum_ramp_timesteps":    {"type": "discrete", "values": [200000, 500000, 1000000, 2000000]},
    "curriculum_ramp_start_value":  {"type": "double", "min": 0.05, "max": 0.3, "scale": "linear"}
  }
}

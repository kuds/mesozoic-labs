+def _zip(path, steps, members=("data", "policy.pth")):
+    with zipfile.ZipFile(path, "w") as z:
+        for m in members:
+            z.writestr(m, json.dumps({"num_timesteps": steps}) if m == "data" else b"weights" * 50)
+
+
+def _sha(p):
+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()
+

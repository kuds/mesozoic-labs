+S, R, G, SAVE, E, EP = 64, 8, 16, 32, 64 + 8 * 40, 3          # E = S + 40 rollouts
+SAVED = tuple(range(S + SAVE, E, SAVE))                          # 96, 128, ..., 352
+STAGE = "01_stance"

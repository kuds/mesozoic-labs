+def _tail3_model(mirror_map, *, seed: int = 13, bound: float | None = None, coef: float = 0.0, bias14=None):
+    """A toy MirrorKLPPO (``_make(seed)``, default SymmetryConfig), optionally with ``action_net.bias[14]`` set by
+    hand (no_grad) and the bound enabled.  Built right before use: SB3 reseeds the global RNGs at construction."""
+    model = MK.enable_mirror_kl(_make(seed=seed), SY.SymmetryConfig(), mirror_map)
+    if bias14 is not None:
+        policy: Any = model.policy
+        with torch.no_grad():
+            policy.action_net.bias[MK.TAIL3_INDEX] = float(bias14)
+    if bound is not None:
+        MK.enable_tail3_upper_bound(model, MK.Tail3UpperBoundConfig(coef, bound))
+    return model
+
+
+def _train_without_steps(model, monkeypatch=None) -> dict:
+    """Fill the buffer (``_setup_learn`` + one ``collect_rollouts``, no update), then run ``train()`` with
+    ``optimizer.step`` replaced by a recorder that copies every gradient and does not step.  With *monkeypatch*,
+    the gradients are also recorded before the clip, with each mini-batch's observations."""
+    _, callback = model._setup_learn(model.n_steps * model.n_envs, None, True, "tail3", False)
+    assert model.collect_rollouts(model.env, callback, model.rollout_buffer, n_rollout_steps=model.n_steps)
+    names = [name for name, _ in model.policy.named_parameters()]
+    params = [p for _, p in model.policy.named_parameters()]
+    record: dict[str, Any] = {"names": names, "post": [], "pre": [], "obs": []}
+
+    def recorder(*_args, **_kwargs):
+        record["post"].append([None if p.grad is None else p.grad.detach().clone() for p in params])
+
+    model.policy.optimizer.step = recorder
+    if monkeypatch is not None:
+        clip = torch.nn.utils.clip_grad_norm_
+
+        def clip_recording(parameters, *args, **kwargs):
+            parameters = list(parameters)
+            record["pre"].append([None if p.grad is None else p.grad.detach().clone() for p in params])
+            return clip(parameters, *args, **kwargs)
+
+        monkeypatch.setattr(torch.nn.utils, "clip_grad_norm_", clip_recording)
+        mirror_loss = model._mirror_loss
+
+        def mirror_loss_recording(update, rollout_data, loss):
+            record["obs"].append(rollout_data.observations.detach().clone())
+            return mirror_loss(update, rollout_data, loss)
+
+        model._mirror_loss = mirror_loss_recording
+    before = _parameters(model)
+    model.train()
+    if monkeypatch is not None:
+        monkeypatch.undo()
+        del model._mirror_loss
+    record["unchanged"] = all(np.array_equal(before[k], v) for k, v in _parameters(model).items())
+    record["adam_empty"] = model.policy.optimizer.state_dict()["state"] == {}
+    record["logged"] = dict(model.logger.name_to_value)
+    return record
+
+
+def _grads_bytes(sequence) -> list[list[bytes | None]]:
+    return [[None if g is None else g.numpy().tobytes() for g in step] for step in sequence]
+

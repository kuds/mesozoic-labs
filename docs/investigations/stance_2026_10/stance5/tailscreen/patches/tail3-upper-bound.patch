+@pytest.mark.parametrize("bound", _BOUNDS)
+def test_tail3_t1a_coef_zero_is_gradient_identical_and_takes_no_step(mirror_map, monkeypatch, bound):
+    """T1a: at coef 0 the recorded (post-clip) gradient sequence equals the no-bound model's byte for byte; no
+    parameter moves; only the bound model logs the six train/tail3_bound_* keys.  At coef 2.7 with
+    action_net.bias[14] = 1.0 (and = b, so rows straddle the bound) the gradients differ, and the pre-clip
+    difference is exactly coef x the gradient of L_B on the rows with mu14 > b."""
+    none = _train_without_steps(_tail3_model(mirror_map))
+    zero = _train_without_steps(_tail3_model(mirror_map, bound=bound, coef=0.0))
+    assert len(none["post"]) == len(zero["post"]) == 2 * (128 // 32)  # n_epochs x mini-batches, all recorded
+    assert _grads_bytes(none["post"]) == _grads_bytes(zero["post"])
+    assert none["unchanged"] and zero["unchanged"] and none["adam_empty"] and zero["adam_empty"]
+    assert not any(key.startswith("train/tail3_bound") for key in none["logged"])
+    assert set(_TAIL3_KEYS) <= set(zero["logged"])
+    assert zero["logged"]["train/tail3_bound_coef"] == 0.0 and zero["logged"]["train/tail3_bound_loss"] == 0.0
+    assert zero["logged"]["train/tail3_bound_b"] == bound
+    assert np.isfinite(zero["logged"]["train/tail3_bound_penalty"]) and zero["logged"]["train/tail3_bound_penalty"] >= 0
+    for bias14 in (1.0, bound):
+        plain = _train_without_steps(_tail3_model(mirror_map, bias14=bias14), monkeypatch)
+        bounded_model = _tail3_model(mirror_map, bound=bound, coef=2.7, bias14=bias14)
+        bounded = _train_without_steps(bounded_model, monkeypatch)
+        assert plain["unchanged"] and bounded["unchanged"]
+        assert _grads_bytes(plain["post"]) != _grads_bytes(bounded["post"])
+        assert bounded["logged"]["train/tail3_bound_coef"] == 2.7
+        assert bounded["logged"]["train/tail3_bound_penalty"] > 0.0
+        names = plain["names"]
+        params = [p for _, p in bounded_model.policy.named_parameters()]
+        n_beyond, n_rows = 0, 0
+        for pre_plain, pre_bounded, obs in zip(plain["pre"], bounded["pre"], bounded["obs"], strict=True):
+            mu = bounded_model.policy.get_distribution(obs).distribution.mean
+            beyond = mu.detach()[:, 14] > bound
+            n_beyond, n_rows = n_beyond + int(beyond.sum()), n_rows + len(beyond)
+            # The bound's gradient from the rows with mu14 > b alone (row mean over the whole mini-batch).
+            rows_term = (torch.nn.functional.relu(mu[beyond][:, 14] - bound) ** 2).sum() / len(mu)
+            expected = torch.autograd.grad(2.7 * rows_term, params, allow_unused=True)
+            for name, a, b, e in zip(names, pre_plain, pre_bounded, expected, strict=True):
+                difference = (b - a).numpy()
+                e = np.zeros_like(difference) if e is None else e.numpy()
+                np.testing.assert_allclose(difference, e, rtol=1e-4, atol=1e-6, err_msg=name)
+                if name.startswith(("value_net", "mlp_extractor.value_net", "log_std")):
+                    assert np.array_equal(a.numpy(), b.numpy()), name  # untouched by the bound, bit for bit
+                if name in ("action_net.weight", "action_net.bias"):
+                    others = np.arange(15) != 14
+                    assert np.array_equal(a.numpy()[others], b.numpy()[others]), name
+        assert 0 < n_beyond <= n_rows
+        if bias14 == bound:
+            assert n_beyond < n_rows  # rows on both sides of b: those at or below it contributed nothing
+

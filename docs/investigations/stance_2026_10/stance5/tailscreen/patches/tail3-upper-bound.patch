+            checked += 1
+            text = path.read_text(encoding="utf-8", errors="replace")
+            hits.extend(f"{path.relative_to(root)}: {n}" for n in needles if n in text)
+    assert checked > 100 and hits == []
+    git = subprocess.run(
+        [
+            "git",
+            "--no-optional-locks",
+            "-C",
+            str(root),
+            "show",
+            "cf80ecb14d1630ce3b4dcdea28a05835d143470b:environments/shared/train_base.py",
+        ],
+        capture_output=True,
+    )
+    if git.returncode != 0:
+        pytest.skip("not a git checkout holding cf80ecb1")
+    assert (root / "environments" / "shared" / "train_base.py").read_bytes() == git.stdout
+
+
+def _save_and_check_bound_zip(model, mirror_map, tmp_path, config) -> None:
+    """T7: the zip's data keys are stock + the two records; stock PPO loads it; reloading never re-enables."""
+    model.save(tmp_path / "bound.zip")
+    _make().save(tmp_path / "stock.zip")
+    data = json.loads(zipfile.ZipFile(tmp_path / "bound.zip").read("data"))
+    stock_keys = set(json.loads(zipfile.ZipFile(tmp_path / "stock.zip").read("data")))
+    assert set(data) == stock_keys | {SY.CHECKPOINT_ATTRIBUTE, MK.TAIL3_BOUND_ATTRIBUTE}
+    assert data[MK.TAIL3_BOUND_ATTRIBUTE] == config.checkpoint_record()
+    assert "_tail3_bound" not in data and "_mirror" not in data
+    loaded = PPO.load(tmp_path / "bound.zip", device="cpu")
+    assert type(loaded) is PPO
+    obs = np.random.default_rng(5).normal(size=(8, 63)).astype(np.float32)
+    np.testing.assert_array_equal(loaded.predict(obs, deterministic=True)[0], model.predict(obs, deterministic=True)[0])
+    again = MK.enable_mirror_kl(PPO.load(tmp_path / "bound.zip", device="cpu"), SY.SymmetryConfig(), mirror_map)
+    assert again._tail3_bound is None
+    update = again._mirror_begin_update()
+    assert "tail3" not in update
+    rows = torch.tensor(np.random.default_rng(6).normal(size=(16, 63)), dtype=torch.float32)
+    tensors = again._mirror_state().tensors
+    update["observations"] = rows[:, tensors["obs_perm"]] * tensors["obs_sign"]
+
+    class Rows:
+        observations = rows
+
+    base = torch.tensor(1.25)
+    out = again._mirror_loss(update, Rows, base)
+    assert "tail3" not in update and len(update["kl"]) == 1
+    assert abs(out.item() - (1.25 + SY.SymmetryConfig().kappa * update["kl"][0])) <= 1e-6
+
+
+def test_tail3_t7a_a_bound_zip_loads_with_stock_ppo(mirror_map, tmp_path):
+    config = MK.Tail3UpperBoundConfig(2.7, 0.6)
+    model = _tail3_model(mirror_map, seed=3)
+    MK.enable_tail3_upper_bound(model, config)
+    _save_and_check_bound_zip(model, mirror_map, tmp_path, config)
+
+
+# ---------------------------------------------------------------------------------------------------- gate tier
+def _digest(model) -> dict[str, bytes]:
+    venv = model.get_vec_normalize_env()
+    out = {f"param.{k}": v.tobytes() for k, v in _parameters(model).items()}
+    out.update({f"adam.{k}.{n}": v.tobytes() for k, s in _adam(model).items() for n, v in s.items()})
+    out.update(
+        {
+            "obs.mean": np.asarray(venv.obs_rms.mean).tobytes(),
+            "obs.var": np.asarray(venv.obs_rms.var).tobytes(),
+            "obs.count": np.float64(venv.obs_rms.count).tobytes(),
+            "ret.mean": np.asarray(venv.ret_rms.mean).tobytes(),
+            "ret.var": np.asarray(venv.ret_rms.var).tobytes(),
+        }
+    )
+    return out
+
+
+@_GATE_ONLY
+def test_tail3_t1b_coef_zero_trains_bit_for_bit_as_no_bound(mirror_map):
+    reference = _tail3_model(mirror_map)
+    reference.learn(total_timesteps=256)
+    for bound in _BOUNDS:
+        model = _tail3_model(mirror_map, bound=bound, coef=0.0)
+        model.learn(total_timesteps=256)
+        assert _digest(model) == _digest(reference)
+        assert set(_TAIL3_KEYS) <= set(model.logger.name_to_value)
+
+
+@_GATE_ONLY
+def test_tail3_t2_same_seed_reproducibility(mirror_map):
+    for bound in _BOUNDS:
+        digests = {}
+        for coef in (0.0, 2.7):
+            runs = []
+            for _ in range(2):
+                model = _tail3_model(mirror_map, bound=bound, coef=coef, bias14=1.0)
+                model.learn(total_timesteps=256)
+                runs.append(_digest(model))
+            assert runs[0] == runs[1], (bound, coef)
+            digests[coef] = runs[0]
+        assert digests[0.0] != digests[2.7], bound
+
+
+@_GATE_ONLY
+def test_tail3_t7b_a_bound_zip_loads_after_one_update(mirror_map, tmp_path):
+    config = MK.Tail3UpperBoundConfig(2.7, 0.6)
+    model = _tail3_model(mirror_map, seed=3, bias14=1.0)
+    MK.enable_tail3_upper_bound(model, config)
+    model.learn(total_timesteps=model.n_steps * model.n_envs)
+    assert model._n_updates > 0 and model.logger.name_to_value["train/tail3_bound_coef"] == 2.7
+    _save_and_check_bound_zip(model, mirror_map, tmp_path, config)

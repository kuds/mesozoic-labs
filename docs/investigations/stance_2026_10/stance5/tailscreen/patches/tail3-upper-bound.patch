+@dataclass(frozen=True)
+class Tail3UpperBoundConfig:
+    """The scoped upper bound on tail_3_pitch_act's policy mean: ``coef * mean_rows relu(mu[:, 14] - bound)^2``."""
+
+    coef: float
+    bound: float
+    index: int = TAIL3_INDEX
+
+    def __post_init__(self) -> None:
+        if isinstance(self.coef, bool) or not isinstance(self.coef, (int, float)):
+            raise ValueError(f"coef must be a number, got {self.coef!r}")
+        if not math.isfinite(self.coef) or self.coef < 0.0:
+            raise ValueError(f"coef must be finite and >= 0, got {self.coef!r}")
+        if isinstance(self.bound, bool) or not isinstance(self.bound, (int, float)):
+            raise ValueError(f"bound must be a number, got {self.bound!r}")
+        if not math.isfinite(self.bound) or not 0.0 < self.bound <= 1.0:
+            raise ValueError(f"bound must be finite with 0 < bound <= 1.0, got {self.bound!r}")
+        if isinstance(self.index, bool) or self.index != TAIL3_INDEX:
+            raise ValueError(f"the bound acts on tail_3_pitch_act (index {TAIL3_INDEX}) only, got index {self.index!r}")
+        object.__setattr__(self, "coef", float(self.coef))
+        object.__setattr__(self, "bound", float(self.bound))
+        object.__setattr__(self, "index", int(self.index))
+
+    def checkpoint_record(self) -> dict[str, Any]:
+        """The JSON-only ``mesozoic_tail3_bound`` record."""
+        return {
+            "coef": self.coef,
+            "bound": self.bound,
+            "index": self.index,
+            "side": "upper",
+            "loss": "coef * mean_rows relu(mu[:, index] - bound)^2",
+        }
+
+
+def tail3_upper_bound_penalty(mu: th.Tensor, bound: float, index: int = TAIL3_INDEX) -> th.Tensor:
+    """``mean over rows of relu(mu[:, index] - bound)^2``: only the upper side of one action's mean pays."""
+    return th.mean(F.relu(mu[:, index] - bound) ** 2)
+


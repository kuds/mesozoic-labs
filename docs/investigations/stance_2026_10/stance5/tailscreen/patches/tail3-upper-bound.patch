+def test_tail3_t3_scope_upper_side_of_index_14_only():
+    rng = np.random.default_rng(7)
+    for bound in _BOUNDS:
+        mu = torch.tensor(rng.uniform(-1.5, 1.5, size=(512, 15)), dtype=torch.float64, requires_grad=True)
+        (grad,) = torch.autograd.grad(MK.tail3_upper_bound_penalty(mu, bound), mu)
+        grad = grad.numpy()
+        m14 = mu.detach().numpy()[:, 14]
+        assert np.all(grad[:, :14] == 0.0)
+        assert np.all(grad[m14 <= bound, 14] == 0.0)
+        assert np.any(m14 < -bound) and np.all(grad[m14 < -bound, 14] == 0.0)  # the lower side included
+        above = m14 > bound
+        assert above.any()
+        np.testing.assert_allclose(grad[above, 14], 2 * (m14[above] - bound) / len(m14), rtol=1e-12, atol=0)
+        # Through a toy policy's action_net: every mu14 = b + 0.11 pulls bias[14] by 0.22 per unit coef.
+        policy = _policy()
+        with torch.no_grad():
+            policy.action_net.weight[14].zero_()
+            policy.action_net.bias[14] = bound + 0.11
+        obs = torch.tensor(rng.normal(size=(128, 63)), dtype=torch.float32)
+        mu_policy = policy.get_distribution(obs).distribution.mean
+        (bias_grad,) = torch.autograd.grad(MK.tail3_upper_bound_penalty(mu_policy, bound), policy.action_net.bias)
+        assert abs(bias_grad[14].item() - 0.22) <= 1e-6
+        assert torch.all(bias_grad[:14] == 0.0)
+

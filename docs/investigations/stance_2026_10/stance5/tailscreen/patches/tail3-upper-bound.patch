+def enable_tail3_upper_bound(model: MirrorKLPPO, config: Tail3UpperBoundConfig | None) -> None:
+    """Scratch: turn the tail_3 upper bound on (``config``) or off (``None``) on a :class:`MirrorKLPPO`.

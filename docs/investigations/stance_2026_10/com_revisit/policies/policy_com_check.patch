+def feet_creep_speed(track: StanceTrack, *, window_start_s: float) -> dict[str, float]:
+    """How fast the feet's mean horizontal position moves over the window: a stance that creeps.
+
+    The least-squares velocity of the foot reference points' centroid over the window, in m/s: its magnitude
+    (``feet_creep_speed_mps``) and its components along the window's mean heading (``feet_creep_fore_aft_mps``,
+    + forward) and left of it (``feet_creep_lateral_mps``).  A settling slide or a buzz back and forth averages
+    out; a steady creep (the Compsognathus robot's 3.2-4.4 mm/s) does not.  Not one of
+    :func:`stance_track_quality`'s keys, so no species pin reads it.
+    """
+    s = stance_track_series(track)
+    t = s["t"]
+    w = window_mask(t, window_start_s)
+    if int(w.sum()) < MIN_WINDOW_SAMPLES:
+        raise ValueError(f"the window holds {int(w.sum())} samples; at least {MIN_WINDOW_SAMPLES} are needed")
+    tw = t[w]
+    feet = s["foot_xy"][w].mean(axis=1)
+    velocity = np.array([_slope(tw, feet[:, 0]), _slope(tw, feet[:, 1])])
+    forward = s["forward"][w].mean(axis=0)
+    forward = forward / max(float(np.linalg.norm(forward)), 1e-12)
+    left = np.array([-forward[1], forward[0]])
+    return {
+        "feet_creep_speed_mps": float(np.linalg.norm(velocity)),
+        "feet_creep_fore_aft_mps": float(velocity @ forward),
+        "feet_creep_lateral_mps": float(velocity @ left),
+    }
+
+
+#: CoM-P1, the same-side lean and creep check on a trained policy's panel of deterministic episodes: a lean key
+#: flags when it keeps one sign across the seeds (two-sided sign test p <= ``alpha``) and its median is at least
+#: its floor (twice the key's resolution floor); the panel creeps when ``creep_episodes`` or more episodes'
+#: feet creep at ``creep_speed_mps`` or more.  The window and the numbers were fixed before the ECS policies'
+#: readings (com_revisit notes, policies/PREREG.txt); see :func:`policy_com_check`.
+POLICY_CHECK_LEAN_FLOORS: dict[str, float] = {"com_lateral_mean_m": 1.0e-3, "root_roll_mean_deg": 0.10}
+POLICY_CHECK_ALPHA = 0.005
+POLICY_CHECK_CREEP_SPEED_MPS = 1.0e-3
+POLICY_CHECK_CREEP_EPISODES = 2
+
+
+def policy_com_check(
+    per_seed: Sequence[Mapping[str, float]],
+    creep_speeds_mps: Sequence[float],
+    *,
+    alpha: float = POLICY_CHECK_ALPHA,
+    lean_floors: Mapping[str, float] = POLICY_CHECK_LEAN_FLOORS,
+    creep_speed_mps: float = POLICY_CHECK_CREEP_SPEED_MPS,
+    creep_episodes: int = POLICY_CHECK_CREEP_EPISODES,
+) -> dict[str, Any]:
+    """CoM-P1 on one checkpoint's panel: does it lean to the same side on (nearly) every seed, or creep?
+
+    *per_seed* holds each episode's :func:`stance_track_quality` numbers and *creep_speeds_mps* each episode's
+    ``feet_creep_speed_mps`` (:func:`feet_creep_speed`), over the same window, every episode one that stood its
+    horizon.  Per lean key: :func:`lean_sign_summary`'s counts and p, the median over seeds and ``flag`` (p <=
+    *alpha* and |median| >= its floor).  ``lean`` is any key's flag; ``creep_seed_indices`` the episodes at or
+    over *creep_speed_mps*; ``creep`` whether there are *creep_episodes* of them or more.  Under a
+    mirror-symmetric plant and spawn distribution each key flags with probability at most 0.0026 on 20 seeds,
+    so ``lean`` at most 0.0052; the neutral-action statue at the same spawns is that null.  Report-only: no
+    gate reads it.
+    """
+    if len(per_seed) != len(creep_speeds_mps):
+        raise ValueError("one creep speed per episode")
+    summary = lean_sign_summary(per_seed, keys=tuple(lean_floors))
+    out: dict[str, Any] = {"n": len(per_seed)}
+    lean = False
+    for key, floor in lean_floors.items():
+        values = np.array([float(m.get(key, NAN)) for m in per_seed], dtype=np.float64)
+        values = values[np.isfinite(values)]
+        median = float(np.median(values)) if values.size else NAN
+        flag = bool(summary[key]["sign_test_p"] <= alpha and abs(median) >= floor)
+        out[key] = {**summary[key], "median": median, "floor": float(floor), "flag": flag}
+        lean = lean or flag
+    speeds = np.asarray(creep_speeds_mps, dtype=np.float64)
+    creeping = [int(i) for i in np.flatnonzero(~(speeds < creep_speed_mps))]
+    out["lean"] = lean
+    out["creep_seed_indices"] = creeping
+    out["creep"] = len(creeping) >= creep_episodes
+    return out

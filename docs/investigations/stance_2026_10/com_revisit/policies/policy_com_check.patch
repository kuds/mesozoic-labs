+def test_a_steady_creep_reads_as_the_feets_speed_and_a_buzz_or_a_settling_slide_does_not():
+    def creep(t):
+        slide = np.zeros((t.size, 2, 2))
+        slide[:, :, 0] = -0.003 * t[:, None]  # both feet backwards at 3 mm/s (the robot's creep)
+        return slide
+
+    def buzz_and_slide(t):
+        slide = np.zeros((t.size, 2, 2))
+        slide[:, :, 0] = 0.002 * np.sin(2 * np.pi * 5 * t)[:, None] + 0.004 * np.minimum(t, 1.0)[:, None]
+        return slide
+
+    yaw = 0.7  # the heading frame turns the creep's world direction back into "backwards"
+    c, s_ = math.cos(yaw), math.sin(yaw)
+    rot = np.array([[c, -s_], [s_, c]])
+
+    def turned(fn):
+        return lambda t: fn(t) @ rot.T
+
+    got = feet_creep_speed(_track(601, yaw=lambda t: np.full(t.size, yaw), foot_xy=turned(creep)), window_start_s=1.0)
+    assert got["feet_creep_speed_mps"] == pytest.approx(0.003)
+    assert got["feet_creep_fore_aft_mps"] == pytest.approx(-0.003)
+    assert got["feet_creep_lateral_mps"] == pytest.approx(0.0, abs=1e-12)
+    still = feet_creep_speed(_track(601, foot_xy=buzz_and_slide), window_start_s=1.0)
+    assert still["feet_creep_speed_mps"] < 2e-4  # a 5 Hz buzz of 2 mm over whole periods and a slide before the window
+
+
+def test_the_policy_check_flags_a_same_side_lean_over_its_floor_and_a_creep_on_two_episodes():
+    lean = [
+        {"com_lateral_mean_m": -0.002 + 0.0001 * k, "root_roll_mean_deg": 0.05 if k % 2 else -0.05} for k in range(20)
+    ]
+    out = policy_com_check(lean, [0.0] * 20)
+    assert out["com_lateral_mean_m"]["flag"] and out["lean"] and not out["creep"]
+    assert out["com_lateral_mean_m"]["sign_test_p"] == pytest.approx(2.0 / 2**20)
+    assert not out["root_roll_mean_deg"]["flag"]  # 10 and 10
+    small = [dict(m, com_lateral_mean_m=-0.0005) for m in lean]  # one-sided on every seed, under the 1 mm floor
+    assert not policy_com_check(small, [0.0] * 20)["lean"]
+    sixteen = [dict(m, com_lateral_mean_m=(-0.002 if k < 16 else 0.002)) for k, m in enumerate(lean)]
+    assert not policy_com_check(sixteen, [0.0] * 20)["lean"]  # 16 of 20: p 0.012 > 0.005
+    seventeen = [dict(m, com_lateral_mean_m=(-0.002 if k < 17 else 0.002)) for k, m in enumerate(lean)]
+    assert policy_com_check(seventeen, [0.0] * 20)["lean"]  # 17 of 20: p 0.0026
+    speeds = [0.0] * 18 + [0.0011, 0.0009]
+    assert policy_com_check(lean, speeds)["creep_seed_indices"] == [18] and not policy_com_check(lean, speeds)["creep"]
+    assert policy_com_check(lean, [0.0] * 18 + [0.001, 0.004])["creep"]
+    with pytest.raises(ValueError, match="one creep speed per episode"):
+        policy_com_check(lean, [0.0])
+
+

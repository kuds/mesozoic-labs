===== 2026-10-30T12:55:12.186Z
SP=S1; R=$SP/foot/stance4/live/run_log.txt; echo "<long text>" >> $R
cat > S2/r10round/bs2_watch.sh <<'EOF'
#!/usr/bin/env bash
# Watch BS2's runner log only (outcome-blind). Exit when a new 'decided'/HALTED/PAUSED/finished line appears, or the runner dies.
L=S2/r10round/bias_screen2/logs/run_waves_bs.log
X=S2/r10round/bias_screen2/logs/run_waves_bs.exit
n0=$(grep -c -E 'decided|HALTED|PAUSED|ALL_DECIDED|finish|exit' "$L")
while true; do
  n=$(grep -c -E 'decided|HALTED|PAUSED|ALL_DECIDED|finish|exit' "$L")
  if (( n > n0 )); then echo "EVENT"; tail -6 "$L"; exit 0; fi
  if [[ -e "$X" ]]; then echo "EXIT FILE"; cat "$X"; tail -6 "$L"; exit 0; fi
  if ! pgrep -f 'bias_screen2/tools/run_waves_bs.sh' >/dev/null; then echo "RUNNER NOT RUNNING"; tail -8 "$L"; exit 0; fi
  sleep 60
done
EOF
chmod +x S2/r10round/bs2_watch.sh; echo ok

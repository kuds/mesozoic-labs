#!/usr/bin/env bash
# Watch BS2's runner log only (outcome-blind). Exit on a problem line, on "all ... decided"<long text>"$P" "$L")
while true; do
  n=$(grep -c -E "$P" "$L")
  if (( n > n0 )); then echo "EVENT"; grep -E "$P" "$L" | tail -4; echo "-- tail"; tail -5 "$L"; exit 0; fi
  if [[ -e "$X" ]]; then echo "EXIT FILE"; cat "$X"; tail -6 "$L"; exit 0; fi
  if ! pgrep -f 'bias_screen2/tools/run_waves_bs.sh' >/dev/null; then echo "RUNNER NOT RUNNING"; tail -8 "$L"<long text>"$(date -u '+%Y-%m-%d %H:%M UTC')  BS2: control_2511 exited 0 at 14:16:18 and COUNTED (CHECK passed, stop reason end; about 82 min); atimes re-armed (P4); control_2521 started 14:16:20. Runner log only read. Watcher re-armed to wake on problems, ALL_DECIDED or the runner's exit. Free 2.73 GiB." >> $SP/foot/stance4/live/run_log.txt

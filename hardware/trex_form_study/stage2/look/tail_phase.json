  "F1 bob": {
   "range": "50-100 % of the enforced stance-leg shortening (0.007-0.014 H nominal, 0.013-0.026 H at the animal pace)",
   "value": 0.75,
   "rule": "bob = 0.75 (duty stride / 2)^2 / (2 (1 - crouch) H) with V0's duty and stride at that speed, held from V1 to V6; V1B50 and V1B100 take 50 % and 100 %",
   "drift": "F3's longer stance (nominal) and F13's stride (75 cm, animal pace) enforce more shortening, so the same bob is a smaller share of the rung's own: about 57 % on the nominal V2-V6 and 55 % on the 75 cm animal-pace V6 (measured per rung: bob_share_of_enforced)"
  },
  "F1 bob_phase": {

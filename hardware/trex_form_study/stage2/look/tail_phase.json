  "F2 bob_skew": {
   "range": "trough at 10-15 % of stance",
   "value": 0.125
  },
  "F2 bob_drop": {
   "range": "settling over 0.1-0.15 s; a quick dip then a slow rise",
   "value": 0.1,
   "rule": "hold the crest through late single support, drop (min-jerk) over 0.1 s to the trough, rise (min-jerk) to the next mid-stance; at the faster walks the drop starts before the touchdown (a 0.1 s drop after it would need more than g downward)"
  },

<mujoco model="velociraptor">
  <compiler angle="degree" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast">
    <flag warmstart="enable"/>
  </option>

  <default>
    <joint limited="true" damping="5.0" armature="0.01"/>
    <geom contype="1" conaffinity="1" friction="1.2 0.005 0.0001"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>

    <!-- Leg joints: firm support for grounded locomotion.  The passive spring
         is anchored at the standing pose by a springref on each leg joint
         below; it cannot live here because every joint stands at its own
         angle, and MuJoCo's default springref is 0, not ref. -->
    <default class="leg_joint">
      <joint damping="10.0" armature="0.05" stiffness="20.0"/>
    </default>

    <!-- Tail joints: high stiffness, limited range (rigid rudder behavior) -->
    <default class="tail_joint">
      <joint damping="15.0" stiffness="40.0" armature="0.03" range="-15 15"/>
    </default>

    <!-- Sickle claw: high torque capability -->
    <default class="claw_joint">
      <joint damping="5.0" armature="0.005"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.8 1.0" rgb2="0.2 0.4 0.6" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.4 0.4 0.4" rgb2="0.3 0.3 0.3" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="body_mat" rgba="0.6 0.5 0.4 1"/>
    <material name="claw_mat" rgba="0.2 0.2 0.2 1"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="50 50 0.1" material="grid_mat" conaffinity="1" contype="1"/>

    <!-- Prey target (mocap body - can be repositioned without recompiling) -->
    <body name="prey" mocap="true" pos="5 0 0.3">
      <geom name="prey_geom" type="sphere" size="0.15" rgba="0.8 0.2 0.2 0.8"
            contype="2" conaffinity="2"/>
    </body>

    <!-- ==================== RAPTOR BODY ==================== -->
    <!--
    Coordinate system:
      +X = forward (direction of travel)
      +Y = left
      +Z = up

    Approximate dimensions (scaled to ~2m nose-to-tail):
      Body length: 0.6m
      Hip height: 0.5m (in neutral crouch)
      Tail length: 0.8m
      Total mass: ~13.5kg
    -->

    <body name="pelvis" pos="0 0 0.50">
      <freejoint name="root"/>

      <!-- Main body: elongated ellipsoid -->
      <geom name="torso" type="capsule" fromto="-0.15 0 0.05  0.25 0 0.05" size="0.08"
            mass="4.0" material="body_mat"/>

      <!-- Head/neck (simplified) -->
      <geom name="neck" type="capsule" fromto="0.25 0 0.05  0.4 0 0.12" size="0.04"
            mass="0.8" material="body_mat"/>
      <geom name="head" type="ellipsoid" pos="0.5 0 0.12" size="0.12 0.04 0.05"
            mass="0.5" material="body_mat"/>

      <!-- IMU sensor site (for observations) -->
      <site name="imu" pos="0 0 0.05" size="0.02"/>

      <!-- ==================== TAIL ==================== -->
      <!-- 5 segments, hinge joints, acts as rigid counterbalance -->

      <body name="tail_1" pos="-0.15 0 0.05">
        <joint name="tail_1_pitch" class="tail_joint" type="hinge" axis="0 1 0"/>
        <joint name="tail_1_yaw" class="tail_joint" type="hinge" axis="0 0 1" range="-10 10"/>
        <geom name="tail_1_geom" type="capsule" fromto="0 0 0  -0.15 0 -0.02" size="0.045"
              mass="1.0" material="body_mat"/>

        <body name="tail_2" pos="-0.15 0 -0.02">
          <joint name="tail_2_pitch" class="tail_joint" type="hinge" axis="0 1 0"/>
          <geom name="tail_2_geom" type="capsule" fromto="0 0 0  -0.15 0 -0.01" size="0.04"
                mass="0.8" material="body_mat"/>

          <body name="tail_3" pos="-0.15 0 -0.01">
            <joint name="tail_3_pitch" class="tail_joint" type="hinge" axis="0 1 0"/>
            <geom name="tail_3_geom" type="capsule" fromto="0 0 0  -0.15 0 0" size="0.035"
                  mass="0.6" material="body_mat"/>

            <body name="tail_4" pos="-0.15 0 0">
              <joint name="tail_4_pitch" class="tail_joint" type="hinge" axis="0 1 0"/>
              <geom name="tail_4_geom" type="capsule" fromto="0 0 0  -0.12 0 0.01" size="0.025"
                    mass="0.4" material="body_mat"/>

              <body name="tail_5" pos="-0.12 0 0.01">
                <joint name="tail_5_pitch" class="tail_joint" type="hinge" axis="0 1 0"/>
                <geom name="tail_5_geom" type="capsule" fromto="0 0 0  -0.1 0 0.02" size="0.015"
                      mass="0.2" material="body_mat"/>
                <!-- Tail tip sensor for stability reward -->
                <site name="tail_tip" pos="-0.1 0 0.02" size="0.01"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== RIGHT LEG ==================== -->
      <!--
      Reading the leg joints.  ``ref``, ``springref`` and the home ``ctrl``
      name three different poses here, and the difference is deliberate:

        ref        the joint value at which the bodies sit exactly as the
                   geoms below author them: hip 38, knee -50, ankle 100,
                   toes 10.  MuJoCo applies the rotation (qpos - ref) and the
                   observation reports qpos, so ref is left alone; moving it
                   would re-label every leg angle the policy reads.
        springref  the standing pose of the home keyframe: hip 38, knee -50,
                   ankle 90.5536, toe_d3 -0.5536, toe_d4 0.6464.  The leg
                   spring (stiffness 20, leg_joint class) is therefore
                   neutral where the animal actually stands.  Before physics
                   revision 3 no leg joint set one, and the default is 0, not
                   ref: the springs pulled the settled hip, knee and ankle
                   (34.0 / -45.2 / 80.2 deg) back toward zero with 11.9 /
                   15.8 / 28.0 N.m, and the statue stood by spending 10.4 /
                   15.1 / 34.5 N.m of servo torque mostly cancelling them.
                   The old keyframe note credited ref with making "joint
                   springs hold this pose at rest"; ref never moves a spring.
        home ctrl  carries the load the springs no longer do: each servo is
                   commanded a small preload past the pose, sized so that its
                   steady-state error is the gravity torque.  See the
                   KEYFRAMES block.
      -->

      <body name="r_thigh" pos="0 -0.08 0">
        <!-- Hip: 2 DOF (flexion/extension + abduction) -->
        <joint name="r_hip_pitch" class="leg_joint" type="hinge" axis="0 1 0" range="-60 90" ref="38"
               springref="38"/>
        <joint name="r_hip_roll" class="leg_joint" type="hinge" axis="1 0 0" range="-30 30" springref="0"/>
        <geom name="r_thigh_geom" type="capsule" fromto="0 0 0  0.02 0 -0.18" size="0.04"
              mass="1.2" material="body_mat"/>

        <body name="r_tibia" pos="0.02 0 -0.18">
          <!-- Knee: 1 DOF (Expanded extension limit from -10 to -5 deg) -->
          <joint name="r_knee" class="leg_joint" type="hinge" axis="0 1 0" range="-120 -5" ref="-50"
                 springref="-50"/>
          <geom name="r_tibia_geom" type="capsule" fromto="0 0 0  -0.02 0 -0.2" size="0.03"
                mass="0.8" material="body_mat"/>

          <body name="r_metatarsus" pos="-0.02 0 -0.2">
            <!-- Ankle: 1 DOF (digitigrade stance) -->
            <joint name="r_ankle" class="leg_joint" type="hinge" axis="0 1 0" range="60 160" ref="100"
                   springref="90.5536"/>
            <geom name="r_metatarsus_geom" type="capsule" fromto="0 0 0  0.06 0 -0.12" size="0.02"
                  mass="0.3" material="body_mat"/>
            <!-- Metatarsal-head touch volume.  A touch sensor only sums
                 contacts on geoms of its site's OWN body, and the toes are
                 child bodies, so r_foot on toe_d3 cannot see this capsule
                 however large it is made.  At the settled stance the
                 metatarsal head carries about 28% of the foot's load. -->
            <site name="r_meta_touch" type="capsule" fromto="0 0 0  0.06 0 -0.12" size="0.045" group="4"/>

            <!-- Toes: 3 separate digits (anatomically correct) -->
            <!-- Digit 3 (central, longest — primary weight-bearing) -->
            <body name="r_toe_d3" pos="0.06 0 -0.12">
              <joint name="r_toe_d3_joint" class="leg_joint" type="hinge" axis="0 1 0" range="-30 60" ref="10"
                     springref="-0.5536"/>
              <geom name="r_toe_d3_geom" type="capsule" fromto="0 0 0  0.10 0 0" size="0.02"
                    mass="0.06" material="body_mat"/>
              <!-- Foot contact sensor (on primary weight-bearing digit).
                   The site must envelop the whole toe capsule: a lying capsule
                   contacts the floor near its ENDS, and a touch sensor only
                   counts contact points inside the site volume. The original
                   r=0.02 sphere at the capsule midpoint missed both end
                   contacts, so the sensor read 0 during normal stance.
                   This digit alone carries about 54% of the foot's load; the
                   metatarsal-head and digit-4 sensors carry the rest, and the
                   env sums all three into the one contact value per foot. -->
              <site name="r_foot" pos="0.05 0 0" size="0.08" group="4"/>
              <!-- group="4": sensor volume only — groups 3+ are hidden in
                   default rendering, so the enlarged site doesn't draw as a
                   large gray ball on the foot in videos. Toggle site group 4
                   in an interactive viewer to visualize the touch volume. -->
            </body>

            <!-- Digit 4 (lateral, shorter — secondary weight-bearing) -->
            <body name="r_toe_d4" pos="0.06 -0.015 -0.12">
              <joint name="r_toe_d4_joint" class="leg_joint" type="hinge" axis="0 1 0" range="-30 60" ref="10"
                     springref="0.6464"/>
              <geom name="r_toe_d4_geom" type="capsule" fromto="0 0 0  0.08 -0.01 0" size="0.018"
                    mass="0.04" material="body_mat"/>
              <!-- Digit-4 touch volume, on its own body for the same reason;
                   it envelops the whole capsule like r_foot does for d3. -->
              <site name="r_d4_touch" pos="0.04 -0.005 0" size="0.07" group="4"/>
            </body>

            <!-- Sickle claw (digit 2) - THE WEAPON -->
            <body name="r_toe_claw" pos="0.06 0.02 -0.12">
              <joint name="r_claw" class="claw_joint" type="hinge" axis="0 1 0" range="-90 30"/>
              <geom name="r_claw_geom" type="capsule" fromto="0 0 0  0.04 0 0.06" size="0.01"
                    mass="0.05" material="claw_mat" contype="2" conaffinity="2"/>
              <!-- Claw tip for strike detection -->
              <site name="r_claw_tip" pos="0.04 0 0.06" size="0.015"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== LEFT LEG ==================== -->

      <body name="l_thigh" pos="0 0.08 0">
        <joint name="l_hip_pitch" class="leg_joint" type="hinge" axis="0 1 0" range="-60 90" ref="38"
               springref="38"/>
        <joint name="l_hip_roll" class="leg_joint" type="hinge" axis="1 0 0" range="-30 30" springref="0"/>
        <geom name="l_thigh_geom" type="capsule" fromto="0 0 0  0.02 0 -0.18" size="0.04"
              mass="1.2" material="body_mat"/>

        <body name="l_tibia" pos="0.02 0 -0.18">
          <!-- Knee: 1 DOF (Expanded extension limit from -10 to -5 deg) -->
          <joint name="l_knee" class="leg_joint" type="hinge" axis="0 1 0" range="-120 -5" ref="-50"
                 springref="-50"/>
          <geom name="l_tibia_geom" type="capsule" fromto="0 0 0  -0.02 0 -0.2" size="0.03"
                mass="0.8" material="body_mat"/>

          <body name="l_metatarsus" pos="-0.02 0 -0.2">
            <joint name="l_ankle" class="leg_joint" type="hinge" axis="0 1 0" range="60 160" ref="100"
                   springref="90.5536"/>
            <geom name="l_metatarsus_geom" type="capsule" fromto="0 0 0  0.06 0 -0.12" size="0.02"
                  mass="0.3" material="body_mat"/>
            <!-- Same own-body rationale as r_meta_touch above. -->
            <site name="l_meta_touch" type="capsule" fromto="0 0 0  0.06 0 -0.12" size="0.045" group="4"/>

            <!-- Toes: 3 separate digits (anatomically correct) -->
            <!-- Digit 3 (central, longest — primary weight-bearing) -->
            <body name="l_toe_d3" pos="0.06 0 -0.12">
              <joint name="l_toe_d3_joint" class="leg_joint" type="hinge" axis="0 1 0" range="-30 60" ref="10"
                     springref="-0.5536"/>
              <geom name="l_toe_d3_geom" type="capsule" fromto="0 0 0  0.10 0 0" size="0.02"
                    mass="0.06" material="body_mat"/>
              <!-- Same coverage and group="4" rationale as r_foot above. -->
              <site name="l_foot" pos="0.05 0 0" size="0.08" group="4"/>
            </body>

            <!-- Digit 4 (lateral, shorter — secondary weight-bearing) -->
            <body name="l_toe_d4" pos="0.06 0.015 -0.12">
              <joint name="l_toe_d4_joint" class="leg_joint" type="hinge" axis="0 1 0" range="-30 60" ref="10"
                     springref="0.6464"/>
              <geom name="l_toe_d4_geom" type="capsule" fromto="0 0 0  0.08 0.01 0" size="0.018"
                    mass="0.04" material="body_mat"/>
              <site name="l_d4_touch" pos="0.04 0.005 0" size="0.07" group="4"/>
            </body>

            <!-- Sickle claw (digit 2) - THE WEAPON -->
            <body name="l_toe_claw" pos="0.06 -0.02 -0.12">
              <joint name="l_claw" class="claw_joint" type="hinge" axis="0 1 0" range="-90 30"/>
              <geom name="l_claw_geom" type="capsule" fromto="0 0 0  0.04 0 0.06" size="0.01"
                    mass="0.05" material="claw_mat" contype="2" conaffinity="2"/>
              <site name="l_claw_tip" pos="0.04 0 0.06" size="0.015"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== FORELIMBS (stubs) ==================== -->
      <!-- Simplified for now - can expand for grappling behavior later -->

      <body name="r_arm" pos="0.2 -0.06 0.02">
        <joint name="r_shoulder_pitch" type="hinge" axis="0 1 0" damping="2.0" range="-30 45"/>
        <joint name="r_shoulder_roll" type="hinge" axis="1 0 0" damping="2.0" range="-20 20"/>
        <geom name="r_arm_geom" type="capsule" fromto="0 0 0  0.08 -0.02 -0.1" size="0.015"
              mass="0.15" material="body_mat"/>
      </body>

      <body name="l_arm" pos="0.2 0.06 0.02">
        <joint name="l_shoulder_pitch" type="hinge" axis="0 1 0" damping="2.0" range="-30 45"/>
        <joint name="l_shoulder_roll" type="hinge" axis="1 0 0" damping="2.0" range="-20 20"/>
        <geom name="l_arm_geom" type="capsule" fromto="0 0 0  0.08 0.02 -0.1" size="0.015"
              mass="0.15" material="body_mat"/>
      </body>

    </body> <!-- end pelvis -->
  </worldbody>

  <!-- ==================== ACTUATORS ==================== -->
  <!-- Position actuators for locomotion, motor for claws -->

  <actuator>
    <!-- NOTE: ctrlrange must be in radians — the compiler angle="degree" setting
         does NOT convert actuator attributes, only joint attributes. -->

    <!-- Right leg -->
    <!-- Hip pitch, knee, and ankle forcerange sized at 1.5x kp (was 0.8x from
         156a933): the 0.8x caps clipped 34-40%/22-25% of a moderate gait cycle
         on hips/ankles and broke stage-2 locomotion. The knee measured 0% at
         the moderate 2.5 Hz/0.8-amplitude regime but 30-46% at sprint-like
         excitation (3-4 Hz, full amplitude), so it carries the same 1.5x
         headroom before faster-gait training.
         1.5x keeps impact spikes bounded while leaving gait
         torques unclipped. See docs/investigations/STAGE2_RECOMMENDATIONS.md R2.
         Standing costs these servos almost nothing: from the gravity-preloaded
         home ctrl (see the keyframe) the settled statue holds hip / knee /
         ankle / toe_d3 at 1.60 / 0.48 / 5.56 / 2.33 N.m, 0.2-5.8% of
         forcerange, where the pre-r3 stance spent 10.4 / 15.1 / 34.5 / 4.3 N.m
         fighting springs anchored at qpos 0. -->
    <position name="r_hip_pitch_act" joint="r_hip_pitch" kp="150" forcerange="-225 225" ctrlrange="-1.0472 1.5708"/>
    <position name="r_hip_roll_act" joint="r_hip_roll" kp="100" forcerange="-80 80" ctrlrange="-0.5236 0.5236"/>
    <position name="r_knee_act" joint="r_knee" kp="180" forcerange="-270 270" ctrlrange="-2.0944 -0.0872"/>
    <position name="r_ankle_act" joint="r_ankle" kp="100" forcerange="-150 150" ctrlrange="1.0472 2.7925"/>
    <position name="r_toe_d3_act" joint="r_toe_d3_joint" kp="50" forcerange="-40 40" ctrlrange="-0.5236 1.0472"/>
    <position name="r_toe_d4_act" joint="r_toe_d4_joint" kp="50" forcerange="-40 40" ctrlrange="-0.5236 1.0472"/>
    <motor name="r_claw_act" joint="r_claw" gear="50" ctrlrange="-1 1"/>

    <!-- Left leg -->
    <position name="l_hip_pitch_act" joint="l_hip_pitch" kp="150" forcerange="-225 225" ctrlrange="-1.0472 1.5708"/>
    <position name="l_hip_roll_act" joint="l_hip_roll" kp="100" forcerange="-80 80" ctrlrange="-0.5236 0.5236"/>
    <position name="l_knee_act" joint="l_knee" kp="180" forcerange="-270 270" ctrlrange="-2.0944 -0.0872"/>
    <position name="l_ankle_act" joint="l_ankle" kp="100" forcerange="-150 150" ctrlrange="1.0472 2.7925"/>
    <position name="l_toe_d3_act" joint="l_toe_d3_joint" kp="50" forcerange="-40 40" ctrlrange="-0.5236 1.0472"/>
    <position name="l_toe_d4_act" joint="l_toe_d4_joint" kp="50" forcerange="-40 40" ctrlrange="-0.5236 1.0472"/>
    <motor name="l_claw_act" joint="l_claw" gear="50" ctrlrange="-1 1"/>

    <!-- Tail actuators for active balance control -->
    <position name="tail_1_pitch_act" joint="tail_1_pitch" kp="60" forcerange="-50 50" ctrlrange="-0.2618 0.2618"/>
    <position name="tail_1_yaw_act" joint="tail_1_yaw" kp="50" forcerange="-40 40" ctrlrange="-0.1745 0.1745"/>
    <position name="tail_2_pitch_act" joint="tail_2_pitch" kp="50" forcerange="-40 40" ctrlrange="-0.2618 0.2618"/>
    <position name="tail_3_pitch_act" joint="tail_3_pitch" kp="40" forcerange="-32 32" ctrlrange="-0.2618 0.2618"/>

    <!-- Forelimb actuators (lightweight — for grappling/balance assist) -->
    <position name="r_shoulder_pitch_act" joint="r_shoulder_pitch" kp="15" forcerange="-12 12" ctrlrange="-0.5236 0.7854"/>
    <position name="r_shoulder_roll_act" joint="r_shoulder_roll" kp="15" forcerange="-12 12" ctrlrange="-0.3491 0.3491"/>
    <position name="l_shoulder_pitch_act" joint="l_shoulder_pitch" kp="15" forcerange="-12 12" ctrlrange="-0.5236 0.7854"/>
    <position name="l_shoulder_roll_act" joint="l_shoulder_roll" kp="15" forcerange="-12 12" ctrlrange="-0.3491 0.3491"/>
  </actuator>

  <!-- ==================== SENSORS ==================== -->

  <sensor>
    <!-- WARNING: the Python env indexes sensordata by POSITION (gyro 0-2,
         accel 3-5, quat 6-9, touch 10-11 and 27-30, ...).  Do not reorder or
         insert sensors without updating RaptorEnv._cache_ids, whose foot
         sensor groups the plant contract fingerprints. -->
    <!-- IMU-like sensors -->
    <gyro name="pelvis_gyro" site="imu"/>
    <accelerometer name="pelvis_accel" site="imu"/>
    <framequat name="pelvis_orientation" objtype="site" objname="imu"/>

    <!-- Foot contact forces.  These two see digit 3 ONLY: a touch sensor
         sums contacts on geoms of its site's own body, and the metatarsus
         and digit 4 are other bodies.  Alone they read about 54% of the
         floor load.  The metatarsal-head and digit-4 sensors at the end of
         this block carry the rest; the env sums d3 + metatarsus + d4 into one
         contact value per foot, which equals the floor force. -->
    <touch name="r_foot_touch" site="r_foot"/>
    <touch name="l_foot_touch" site="l_foot"/>

    <!-- Claw tip positions (for strike detection) -->
    <framepos name="r_claw_pos" objtype="site" objname="r_claw_tip"/>
    <framepos name="l_claw_pos" objtype="site" objname="l_claw_tip"/>

    <!-- Tail tip for stability monitoring -->
    <framepos name="tail_tip_pos" objtype="site" objname="tail_tip"/>
    <velocimeter name="tail_tip_linvel" site="tail_tip"/>
    <gyro name="tail_tip_angvel" site="tail_tip"/>

    <!-- Metatarsal-head and digit-4 contact forces (indices 27-30, right
         foot first).  Appended last so every index above stays put. -->
    <touch name="r_meta_touch" site="r_meta_touch"/>
    <touch name="r_d4_touch" site="r_d4_touch"/>
    <touch name="l_meta_touch" site="l_meta_touch"/>
    <touch name="l_d4_touch" site="l_d4_touch"/>
  </sensor>

  <!-- ==================== CONTACT EXCLUSIONS ==================== -->
  <!-- Prevent self-collision in tail chain -->

  <contact>
    <exclude body1="pelvis" body2="tail_1"/>
    <exclude body1="tail_1" body2="tail_2"/>
    <exclude body1="tail_2" body2="tail_3"/>
    <exclude body1="tail_3" body2="tail_4"/>
    <exclude body1="tail_4" body2="tail_5"/>

    <!-- Prevent thigh-torso collision -->
    <exclude body1="pelvis" body2="r_thigh"/>
    <exclude body1="pelvis" body2="l_thigh"/>

    <!-- Adjacent toe digits interpenetrate at rest (d3 r=0.02 at y=0, d4
         r=0.018 at y=-/+0.015): without an exclude the solver holds a large
         constant repulsion force between them that also pollutes the foot
         touch sensors. The digits are anatomically side-by-side; they never
         need to collide with each other. -->
    <exclude body1="r_toe_d3" body2="r_toe_d4"/>
    <exclude body1="l_toe_d3" body2="l_toe_d4"/>
  </contact>

  <!-- ==================== KEYFRAMES ==================== -->
  <!-- Standing pose with forward-leaning torso (20 deg pelvis pitch), matching
       dromaeosaurid biomechanics: horizontal torso counterbalanced by tail,
       with the CoM balanced over flat digitigrade feet and a shallow (0.5 mm)
       floor contact.  The leg ctrl carries a preload against gravity.

       Leg qpos, in degrees:  hip 38   knee -50       ankle 90.5536
                              toe_d3 -0.5536   toe_d4 0.6464
       Leg ctrl, in degrees:  hip 37.3939   knee -49.8339   ankle 93.7599
                              toe_d3 2.0971    toe_d4 1.7735

       Hip and knee stay at ref (38 = 18 deg of crouch + 20 deg of lean
       compensation), which is what puts the feet under the CoM: it projects
       0.05 m inside the floor-contact hull, mid-way along digit 3.  The
       ankle and toes flatten the foot instead: the pelvis pitch plus every
       rotation from ref along hip, knee, ankle and toe sums to zero, so
       digit 3 lies level.  The earlier keyframe kept every joint at ref and
       stood on toes tipped 20 deg toe-down, 44.6 mm inside the floor, and
       every reset settles to the keyframe's own clearance.  Re-posing the
       hip to 18 deg flattens the toes too, but moves the support 7.6 cm
       ahead of the CoM and the statue falls backward in 0.66 s.  Digit 4 is
       keyed 1.2 deg toe-down of digit 3: its capsule is 2 mm thinner, so a
       level digit 4 hovers; 1.2 deg gives each foot d3 / metatarsus / d4
       loads of 0.272 / 0.141 / 0.087 BW at the settled stance.  Root z
       0.505543 is the height at which digit 3 and the metatarsal head sit

<mujoco model="velociraptor_mongoliensis_anatomical">
  <!-- Physics r5 (the maintainer's decision of 2026-11-08): life-size Velociraptor mongoliensis at the scale
       of IGM 100/986 (Norell & Makovicky 1999, "N&M 1999"), rebuilt "of equivalent nature" to the anatomical
       T. rex plant.  Every number is cited inline to its primary source, marked [design] with the rule that
       set it, or measured on this model (the measurement is quoted).  configs/plant_versions.toml note 22
       records the derivation, and the screens behind the [design] values cited to it here.  This file is the
       source of truth (no generator is committed): edit the numbers here and re-measure every constant listed at the
       keyframe.
       Every body frame is world-aligned at the home pose and every joint's ref IS its home angle, so the
       geometry below is authored in the standing pose itself (qpos0 = the stance, unlike the T. rex's
       columnar qpos0) and each joint reads an anatomical angle:
         hip_pitch  femur angle from vertical (negative = knee ahead of the hip; home -35)
         knee       flexion from a straight limb (home 55, i.e. 125 deg interior)
         ankle      metatarsus relative to the tibiotarsus line (negative = flexed; home -28.5)
         toe_d3/d4  digit relative to the metatarsus (home -81.5: the digits lie level)
         toe_d2     MTP-II, negative = extension (home -35: Bishop 2019 resting extension)
         claw       ungual II on II-2, positive = flexion/strike (home -21: resting extension)
       Hinge axes are world y (pitch), x (roll) and z (yaw) on both sides, as on the T. rex, except digits III
       and IV: their axes are horizontal and perpendicular to each digit, so each flexes in its own vertical
       plane (the left axis is the right one mirrored as an axial vector, (x, y, z) -> (-x, y, -z)). -->
  <compiler angle="degree" autolimits="true"/>

  <!-- Options as the r4 raptor (plant_versions note 17, D-D30) and the T. rex (note 16): 2 ms,
       implicitfast, the isotropic elliptic cone so every heading is physically identical; solver defaults
       (Newton, 100 iterations, impratio 1). -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic">
    <flag warmstart="enable"/>
  </option>


  <default>
    <!-- No joint dynamics by default: every hinge sets its own damping and armature below (the free root
         joint takes none). -->
    <joint limited="true"/>
    <!-- contype/conaffinity 1/1 and friction 1.2 as the T. rex and the r4 raptor; condim 3, solref and
         solimp at MuJoCo defaults. -->
    <geom contype="1" conaffinity="1" friction="1.2 0.005 0.0001"/>

    <!-- Hip, knee, ankle.  stiffness 24 N.m/rad: the r4 raptor's leg spring 20 (plant_versions
         note 17) x this plant's m.g.h ratio 76.1 / 62.2 N.m (1.22, both at the home keyframe; 1.24 settled),
         rounded to 1.2.  springref is the
         home angle on every leg joint, so the spring is a declared compliance neutral at the stance, never
         the support (plant_versions note 14a; measured: the statue stands with these springs deleted, 40/40
         at reset noise 0.05, seeds 3042-3081).  armature 0.05 as
         the r4 raptor.  damping 25 (r4 10) [design]: it is set by the whole-body fore-aft
         rocking mode on the passive toes (0.69 Hz in the linearised statue), whose damping ratio
         it raises to 0.35 (measured: 0.25 with damping 15; the r4 raptor 0.36); single-joint damping
         ratios (servo kp + k against the home-pose inertia) 2.18 / 2.97 / 4.61 at hip / knee / ankle. -->
    <default class="leg_joint">
      <joint damping="25" armature="0.05" stiffness="24"/>
    </default>

    <!-- Load-bearing digits III and IV: PASSIVE sprung MTP hinges (T. rex note 9).  The CoM stands over the
         digits, so the four toe springs set the whole body's pitch stiffness about the MTP line:
         4 x 120 = 480 N.m/rad = 6.3 x m.g.h [design]; k 30 left a slow 2 deg pitch drift,
         and k 80 and k 200 stood fewer action-noise statues than 120 (note 22).  The static load is a
         springref preload on each toe joint, not stiffness.  armature 0.004 dominates the 11-17 g digit and
         sets omega.dt 0.34 at 2 ms (the plant's largest; the compsognathus MTP servo rang at 0.85, note 15e);
         damping 4: damping ratio 2.85 (overdamped, as the T. rex toes). -->
    <default class="toe_joint">
      <joint damping="4" armature="0.004" stiffness="120"/>
    </default>

    <!-- Digit II, MTP-II: passive, held raised (hyperextended) by its spring, standing in for the passive
         structures that hold the digit aloft (Bishop 2019).  stiffness 20 [design]: the claw servo's
         whole 4 N.m reaction deflects it 11.5 deg, inside its 15 deg extension travel.
         damping 0.3 / armature 0.001 [design]: damping ratio 1.03, omega.dt 0.28. -->
    <default class="d2_joint">
      <joint damping="0.3" armature="0.001" stiffness="20"/>
    </default>

    <!-- Sickle claw (ungual II on II-2, IP2): an actuated, BOUNDED position servo (the r4 claw was an
         unbounded gear-50 motor).  damping 0.15 / armature 0.001 [design]: damping ratio 1.05 and
         omega.dt 0.14 at kp 5. -->
    <default class="claw_joint">
      <joint damping="0.15" armature="0.001"/>
    </default>

    <!-- Mobile proximal tail (caudals 1-9, N&M 1999 pp. 24-25), servoed.  Its gravity torque is carried by a
         springref PRELOAD on each pitch joint (the T. rex's tail since physics r10, plant_versions note 20, D-D44), so each servo
         holds about 0 at home, its home ctrl is the pose (the ctrlrange midpoint) and the residual action is
         symmetric.  stiffness 6 [design], kp/6 on tail_1 and tail_2: a servo reaches kp/(kp + k) of its
         range, so k 20 against kp 30 left 31-56 % (measured on a k 20 build, note 22); k 6 gives 84-90 %.  damping
         3 / armature 0.01 [design]: damping ratios 0.51 / 0.66 / 0.73 (pitch 1-3), 0.55 (yaw). -->
    <default class="tail_joint">
      <joint damping="3" stiffness="6" armature="0.01"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.8 1.0" rgb2="0.2 0.4 0.6" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.4 0.4 0.4" rgb2="0.3 0.3 0.3" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="body_mat" rgba="0.6 0.5 0.4 1"/>
    <material name="belly_mat" rgba="0.66 0.57 0.46 1"/>
    <material name="head_mat" rgba="0.55 0.45 0.36 1"/>
    <material name="pad_mat" rgba="0.42 0.36 0.30 1"/>
    <material name="claw_mat" rgba="0.2 0.2 0.2 1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="50 50 0.1" material="grid_mat" conaffinity="1" contype="1"/>

    <!-- Prey target (mocap body), as on the r4 raptor: the life-size animal is about the r4 plant's size, so the
         0.15 m sphere at 0.3 m stays the strike task scale.  contype/conaffinity 2: it meets only the
         claws. -->
    <body name="prey" mocap="true" pos="5 0 0.3">
      <geom name="prey_geom" type="sphere" size="0.15" rgba="0.8 0.2 0.2 0.8" contype="2" conaffinity="2"/>
    </body>

    <!-- ==================== VELOCIRAPTOR (IGM 100/986, life size) ====================
         +X forward, +Y left, +Z up.  The pelvis origin is the midpoint of the two acetabula, so root z is hip
         height and "CoM ahead of the hip" is the CoM x in this frame.  The frame is authored LEVEL (sacrum
         horizontal: Senter & Robins 2015; N&M 1999 "the horizontal sacral axis") and the keyframe is that level,
         authored pose; the noise-free statue settles 0.134 deg nose-down from it, and natural_pitch (0.002 rad,
         0.115 deg) is the 40-seed mean at reset noise 0.05 (the keyframe comment).
         Measured at home: hip height 0.5488 m; CoM 0.1129 m ahead of the hip and
         0.0317 m below it in this standing crouch; in Macaulay et al. 2023's standardised neutral posture
         (legs straight and vertical, neck and head horizontal, arms hanging) 0.103 m ahead and
         0.056 m below, against their 0.086-0.109 / 0.065-0.078 m scaled to 15 kg by mass^(1/3)
         (CC_CoM 34.8-44.2 and DV_CoM -26.5 to -31.8 mm/kg^0.33, Fig. 2a and Suppl. Figs 4, 15).  Head tip
         0.176 m above hip height; snout to tail tip 1.736 m; animal mass 15 kg
         (body_subtreemass of pelvis; mj_getTotalmass also counts the 14.14 kg prey sphere).
         Body mass 15 kg (Dececchi et al. 2020 Table 1, IGM 100/986).  Trunk 7.1 kg (Macaulay et al. 2023
         iterations 1-4 torso 40-58 %, Suppl. Fig. 14), placed low (a belly capsule, as the T. rex's): the dorsal torso (column, lungs, air sacs;
         3.2 kg, 872 kg/m3 against Macaulay's torso 850) ends at the
         postacetabular ilium (68.2 mm, N&M 1999 Table 4); the ventral belly (gut, retroverted pubis,
         3.4 kg, 884 kg/m3); the pectoral ribcage capsule (0.5 kg, 544 kg/m3).  Depth
         0.193 m and width 0.110-0.120 m [design: Linheraptor furcula 110 mm x 1.035, Dececchi et al.
         2016; sternal plates and pubis, N&M 1999]; at the acetabulum the silhouette is the thighs' 0.157 m. -->
    <body name="pelvis" pos="0 0 0.548794">
      <freejoint name="root"/>
      <geom name="torso" type="capsule" fromto="-0.013 0 0.028  0.3 0 0.028" size="0.055" mass="3.2" material="body_mat"/>
      <geom name="belly" type="capsule" fromto="-0.03 0 -0.05  0.23 0 -0.05" size="0.06" mass="3.4" material="belly_mat"/>
      <geom name="ribcage" type="capsule" fromto="0.22 0 -0.025  0.33 0 -0.025" size="0.042" mass="0.5" material="body_mat"/>
      <site name="imu" type="sphere" pos="0.1 0 0" size="0.02"/>
      <!-- ==================== NECK + SKULL ====================
             Neck base at the cervicodorsal joint, 0.37 m ahead of the acetabulum ([design]: first dorsal to
             acetabulum 0.345-0.38 m from the Linheraptor trunk, Xu et al. 2010, x 1.035, plus the preacetabular
             sacrum).  S-curved neck (Ostrom 1969 p. 49; Linheraptor neural spines, Xu et al. 2010), 0.32 m along its
             curve (Linheraptor cervical series x 1.035 = 0.331 m): a steep base (55 deg) and a flatter
             upper neck (22 deg), chord 35.3 deg above horizontal ([design] base 45-60, chord
             30-40 deg after Senter & Robins 2015 Fig. 5B; no quantitative Velociraptor carriage is published).
             0.9 kg (6 %: Macaulay et al. 2023 neck 4.3-10.4 %); radii 32 / 26 mm give 990 / 734 kg/m3
             (Macaulay neck 800).  NON-colliding like the T. rex neck (contype 0).
             neck_pitch / head_pitch servos hold the carriage from a gravity preload in the home ctrl (the T. rex
             neck, unpreloaded, sags 12 deg: TyrannosaurusRexEnv._NECK_SETTLED_QPOS).  Ranges: the T. rex widths (neck pitch 70, yaw 40 deg,
             tyrannosaurus_rex_anatomical.xml) centred on the stance.  damping 3 / 2, armature 0.01 [design]: damping
             ratios 0.63 / 0.67, omega.dt 0.03 / 0.03. -->
      <body name="neck" pos="0.37 0 0.03">
        <joint name="neck_pitch" type="hinge" axis="0 1 0" range="-35 35" damping="3" armature="0.01"/>
        <joint name="neck_yaw" type="hinge" axis="0 0 1" range="-20 20" damping="2" armature="0.01"/>
        <geom name="neck_geom" type="capsule" fromto="0 0 0  0.074565 0 0.10649" size="0.032" mass="0.55" material="body_mat" contype="0" conaffinity="0"/>
        <geom name="neck_upper_geom" type="capsule" fromto="0.074565 0 0.10649  0.25073 0 0.177665" size="0.026" mass="0.35" material="body_mat" contype="0" conaffinity="0"/>
        <!-- Skull 0.23 m (GIN 100/25, Barsbold & Osmolska 1999 Table 1; Linheraptor 233 mm x 1.035), long axis
                 8 deg nose-down ([design] 0-15 deg, Senter & Robins 2015 Fig. 5B).  Low and narrow: cranium
                 ellipsoid 116 x 76 x 76 mm (temporal width 77, cranial depth 66 mm plus the jaw adductors), snout ellipsoid
                 148 x 34 x 50 mm (snout 22 mm wide and 45 deep in bone), mandible and throat capsule r 14 mm: 0.61 L holding
                 the 0.75 kg (5 %: Macaulay et al. 2023 head 4.9-5.2 %) at 1254 / 1215 / 1196 kg/m3 (implied densities checked as note 15a asks); 0.61 L is under
                 the ~0.7 L Macaulay's hull implies.  skull_upper and snout collide (head-floor termination, as on the T. rex);
                 the mandible is visual.  head_pitch range: the T. rex width 60 deg centred on the stance; damping 0.5,
                 armature 0.005 [design]: damping ratio 0.76, omega.dt 0.05. -->
        <body name="skull" pos="0.25073 0 0.177665">
          <joint name="head_pitch" type="hinge" axis="0 1 0" range="-30 30" damping="0.5" armature="0.005"/>
          <geom name="skull_upper" type="ellipsoid" pos="0.056568 0 0.000128" size="0.058 0.038 0.038" quat="0.997564 0 0.069756 0" mass="0.44" material="head_mat"/>
          <geom name="snout" type="ellipsoid" pos="0.155627 0 -0.027931" size="0.074 0.017 0.025" quat="0.997564 0 0.069756 0" mass="0.16" material="head_mat"/>
          <geom name="mandible" type="capsule" fromto="0.015909 0 -0.030511  0.199108 0 -0.056258" size="0.014" mass="0.15" material="head_mat" contype="0" conaffinity="0"/>
          <site name="head_tip" type="sphere" pos="0.227762 0 -0.03201" size="0.01"/>
        </body>
      </body>
      <!-- ==================== TAIL ====================
             0.82 m, 40 caudals (IGM 100/986 Ca1-Ca25 sum 597 mm, N&M 1999 Table 5, tapered on to 40 caudals:
             Deinonychus "no less than 36 and probably no more than 40", Ostrom 1969 p. 60; IGM 100/25 has 43).  Joints
             only where the vertebrae are mobile, Ca1-Ca9 (0.206 m: normal zygapophyses and chevrons; the
             prezygapophyseal rods begin at Ca10, N&M 1999 pp. 24-25):
               tail_1 = Ca1-5 (0.105 m), pitch + yaw     tail_2 = Ca6-9 (0.101 m), pitch
               tail_3 = Ca10-17 (0.209 m), pitch: the rod base.  The Ca10+ rods reach forward to Ca6 (N&M 1999 p. 25)
                        and resist dorsoventral bending most (Persons & Currie 2012), so this joint (kept: the T. rex
                        body tree has one) is the stiffest tail servo, kp 50.
               tail_4 = Ca18-27 and tail_5 = Ca28-40: FUSED (no joint), the stiffened rod (Ostrom 1969 "a single
                        rigid body"), as the T. rex's ossified-tendon distal tail.
             2.05 kg (13.7 %: between Macaulay et al. 2023's short-tailed <= 10 % and Grossi et al. 2014's
             ~15 %; a frustum of radius 45 -> 8 mm over 0.82 m at 1000 kg/m3 holds 2.1 kg), split
             0.683 / 0.497 / 0.497 / 0.273 / 0.1 kg, the caudofemoralis-heavy base first; radii 40 / 33 / 26 / 18.5 / 12.5 mm
             give 858 / 1002 / 960 / 1038 / 1010 kg/m3.  The tail took 0.40 kg from the trunk:
             with the 1.65 kg tail, the trimmed torso and the arms moved forward the neutral-posture CoM would sit at
             0.115 m, past the 0.109 m end of the mass-scaled band (above).  Held horizontal on the sacral line (Senter &
             Robins 2015 Fig. 5B) by a springref preload on each pitch joint (tail_joint class).  Ranges: the T. rex
             tail_joint width +-12 deg (tail_3 +-10, the rod base); every joint settles more than 0.15 rad from its
             stops. -->
      <body name="tail_1" pos="-0.068 0 0.03">
        <joint name="tail_1_pitch" class="tail_joint" type="hinge" axis="0 1 0" range="-12 12" springref="45.296437"/>
        <joint name="tail_1_yaw" class="tail_joint" type="hinge" axis="0 0 1" range="-12 12" springref="0"/>
        <geom name="tail_1_geom" type="capsule" fromto="0 0 0  -0.105 0 0" size="0.04" mass="0.683" material="body_mat"/>
        <body name="tail_2" pos="-0.105 0 0">
          <joint name="tail_2_pitch" class="tail_joint" type="hinge" axis="0 1 0" range="-12 12" springref="28.491327"/>
          <geom name="tail_2_geom" type="capsule" fromto="0 0 0  -0.101 0 0" size="0.033" mass="0.497" material="body_mat"/>
          <body name="tail_3" pos="-0.101 0 0">
            <joint name="tail_3_pitch" class="tail_joint" type="hinge" axis="0 1 0" range="-10 10" springref="17.908679"/>
            <geom name="tail_3_geom" type="capsule" fromto="0 0 0  -0.209 0 0" size="0.026" mass="0.497" material="body_mat"/>
            <body name="tail_4" pos="-0.209 0 0">
              <geom name="tail_4_geom" type="capsule" fromto="0 0 0  -0.22 0 0" size="0.0185" mass="0.273" material="body_mat"/>
              <body name="tail_5" pos="-0.22 0 0">
                <geom name="tail_5_geom" type="capsule" fromto="0 0 0  -0.185 0 0" size="0.0125" mass="0.1" material="body_mat"/>
                <site name="tail_tip" type="sphere" pos="-0.185 0 0" size="0.01"/>
              </body>
            </body>
          </body>
        </body>
      </body>
      <!-- ==================== RIGHT LEG ====================
             IGM 100/986: femur 0.238, tibiotarsus 0.255, MT III 0.0991 m (N&M 1999 Tables 2-3).  Hip joint centres
             85 mm apart: 0.355 x femur (Macaulay et al. 2023 Suppl. Fig. 13, femur-scaled).  Scaled by mass^(1/3)
             as the CoM is, they would be 59 mm apart, which the 72 mm thighs cannot clear, so 85 mm is also the
             girth lower bound.
             POSTURE: Bishop et al. 2018's Troodon "characteristic posture" (cancellous-bone alignment, Fig. 5; Allen
             et al. 2013 Velociraptor soft tissues): femur 35 deg from vertical, knee flexion 55 (interior
             125), ankle flexion 28.5 (interior 151.5), abduction 4 (Bishop: 3; [design] +1:
             with 3 deg the action-noise statue stood 16/20 at sigma 0.07 and with 4 deg, digit IV yawed 20 deg and leg
             damping 15, 20/20; note 22).  Chosen over the T. rex recipe (135 deg knee, hip over ankle) because it is
             the paravian evidence and it puts the MTP joint 0.064 m ahead of the hip, under a CoM 0.113 m
             ahead; hip-over-ankle was a constraint for re-posing an existing plant, not anatomy.  Leg-length
             authority at the knee 0.114 m/rad (the T. rex 135 deg knee: 0.134; the singular 172 deg knee: 0.024, note 4).
             Thigh 1.11 / shank 0.57 / metatarsus 0.07 / digits 0.05 kg: Bishop et al. 2018 Fig. 2D's 61.9 / 31.6 /
             3.7 / 2.8 % split of a 1.80 kg leg (12 % of the body; Macaulay et al. 2023 both hindlimbs 20-29 %).  The
             thigh capsule (r 36 mm, 1089 kg/m3) stops at 85 % of the femur so its mass sits proximally, as
             the thigh muscles do; shank r 25 mm (1083 kg/m3). -->
      <body name="r_thigh" pos="0 -0.0425 0">
        <joint name="r_hip_pitch" class="leg_joint" type="hinge" axis="0 1 0" range="-100 30" ref="-35" springref="-35"/>
        <joint name="r_hip_roll" class="leg_joint" type="hinge" axis="1 0 0" range="-25 25" springref="0"/>
        <geom name="r_thigh_geom" type="capsule" fromto="0 0 0  0.116035 -0.01156 -0.165311" size="0.036" mass="1.11" material="body_mat"/>
        <body name="r_tibia" pos="0.136511 -0.0136 -0.194483">
          <joint name="r_knee" class="leg_joint" type="hinge" axis="0 1 0" range="5 105" ref="55" springref="55"/>
          <geom name="r_tibia_geom" type="capsule" fromto="0 0 0  -0.080238 -0.015378 -0.219915" size="0.025" mass="0.57" material="body_mat"/>
          <!-- Metatarsus (MT III 99.1, MT II 84.8, MT IV 91.6 mm, N&M 1999 Table 3) ending in the MTP pad.  Its
                       shaft capsule (r 11 mm) ends 8 mm short of the MTP condyle, 14.4 mm clear of the floor at
                       home (a metatarsus on the floor makes the foot part-plantigrade; note 15b).  FOOT, functionally didactyl (Xing et al. 2013, track formula x-1-3-4-x): a rounded MTP
                       pad under distal MT III-IV, digit III and digit IV pads; digit II raised; no hallux contact. -->
          <body name="r_metatarsus" pos="-0.087215 -0.016715 -0.239038">
            <joint name="r_ankle" class="leg_joint" type="hinge" axis="0 1 0" range="-78.5 21.5" ref="-28.5" springref="-28.5"/>
            <geom name="r_metatarsus_geom" type="capsule" fromto="0 0 0  0.013465 -0.006285 -0.08988" size="0.011" mass="0.055" material="body_mat"/>
            <!-- MTP pad: a capsule lying across MT III-IV (40 x 30 mm; the track pad is 33 x 31 mm in 13-16 cm
                           tracks, Xing et al. 2013), centred 10 mm behind the MTP III joint and 5 mm toward MT IV
                           ("a large, rounded metatarsophalangeal pad").  Rounded, not a box: a box loads only at its corners
                           (docs/investigations/TREX_STANCE_SYMMETRY_AND_FOOT_2026_10.md). -->
            <geom name="r_mtp_pad" type="capsule" fromto="0.004648 -0.016837 -0.100773  0.004648 -0.006837 -0.100773" size="0.015" mass="0.015" material="pad_mat"/>
            <site name="r_foot" type="box" pos="0.004648 -0.011837 -0.111773" size="0.03 0.03 0.016" group="4"/>
            <!-- Digit II held raised in Bishop 2019's resting pose: MTP-II 35 deg extension, IP1 76, IP2
                           21 deg (Table 1, Eqs. 1-2: the posture-1 threshold, metatarsus 8.5 deg from vertical).  II-1 26.6,
                           II-2 28.0 mm (N&M 1999 Table 3).  The phalanges are visual (contype 0) so digit II never loads the
                           floor or the reset settle; the MTP-II hinge is passive and sprung (d2_joint class).  Range
                           -50 to -31 deg [design]: the flexion stop keeps the claw at least 3.3 mm above the
                           floor plane at any claw angle over digit II's whole range, and +-2.9 deg reset noise stays inside it. -->
            <body name="r_toe_d2" pos="0.012534 0.00515 -0.083664">
              <joint name="r_toe_d2_joint" class="d2_joint" type="hinge" axis="0 1 0" range="-50 -31" ref="-35" springref="-35.023179"/>
              <geom name="r_toe_d2_p1" type="capsule" fromto="0 0 0  0.018351 0.000575 -0.019248" size="0.0065" mass="0.005" material="body_mat" contype="0" conaffinity="0"/>
              <geom name="r_toe_d2_p2" type="capsule" fromto="0.018351 0.000575 -0.019248  0.042487 0.004079 -0.005494" size="0.0055" mass="0.004" material="body_mat" contype="0" conaffinity="0"/>
              <!-- Sickle claw: ungual II, 70 mm along the curve (55 mm chord; IGM 100/982 66.3, IGM 100/985 64.8 mm, scaled
                               by the 23.4 mm proximal height of IGM 100/986, N&M 1999 Table 3), on IP2.  contype/conaffinity 2/2 (prey
                               only, as on r4).  Range -38 to +40 deg: Bishop 2019's IP2 extension limit, and a
                               flexion limit that keeps the tip 10 mm above the floor with digit II at rest; 19.6 mm clear
                               at home.  Only IP2 is actuated (MTP-II passive, IP1 fused into the digit II body), so the strike is an
                               ungual flick of 61 deg from rest against ~70 deg of anatomical IP2 flexion (Bishop 2019). -->
              <body name="r_toe_claw" pos="0.042487 0.004079 -0.005494">
                <joint name="r_claw" class="claw_joint" type="hinge" axis="0 1 0" range="-38 40" ref="-21"/>
                <geom name="r_claw_geom" type="capsule" fromto="0 0 0  0.034483 0.006601 0.042336" size="0.0065" mass="0.011" material="claw_mat" contype="2" conaffinity="2"/>
                <site name="r_claw_tip" type="sphere" pos="0.034483 0.006601 0.042336" size="0.008"/>
              </body>
            </body>
            <!-- Digit III (III-1 44.0, III-2 27.4 mm, N&M 1999 Table 3; III-3 ~23.6 and ungual ~35.5 mm estimated from
                           Linheraptor, Deinonychus and IGM 100/985 ratios): ONE segment on a passive sprung MTP hinge.  The
                           contact capsule runs 35-115 mm ahead of the joint: the III-2 and III-3 pads and the ungual's
